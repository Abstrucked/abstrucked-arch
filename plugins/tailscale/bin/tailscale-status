#!/bin/bash
# Prints tailscale's connection state, either as waybar custom-module JSON
# (default) or as a plain one-line string with --plain, for reuse by the
# awesome.lua widget. Requires: tailscale, jq.
set -euo pipefail

icon_up=$'\U000F0928'
icon_down=$'\U000F092D'

status="$(tailscale status --json 2>/dev/null)" || status=""

if [[ -z "$status" ]]; then
  text="$icon_down off"
  tooltip="tailscale: not running"
  class="disconnected"
else
  backend_state="$(jq -r '.BackendState' <<<"$status")"
  self_ip="$(jq -r '.Self.TailscaleIPs[0] // ""' <<<"$status")"
  if [[ "$backend_state" == "Running" && -n "$self_ip" ]]; then
    text="$icon_up $self_ip"
    tooltip="tailscale: connected as $self_ip"
    class="connected"
  else
    text="$icon_down off"
    tooltip="tailscale: $backend_state"
    class="disconnected"
  fi
fi

if [[ "${1:-}" == "--plain" ]]; then
  echo "$text"
else
  jq -nc --arg text "$text" --arg tooltip "$tooltip" --arg class "$class" \
    '{text: $text, tooltip: $tooltip, class: $class}'
fi
