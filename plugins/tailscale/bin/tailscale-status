#!/bin/bash
# Prints tailscale's connection state as waybar custom-module JSON, also
# consumed by the awesome.lua widget. Only the state is reported, never the
# device IP, so the bar is safe for screenshots and screen shares. "text" is
# "on" or "off"; the icon is left to waybar.jsonc, keyed by "alt" (same as
# "class": connected, disconnected or error). Requires: tailscale, jq.
set -euo pipefail

status=""
state=""
read_error=0
if ! status="$(tailscale status --json 2>/dev/null)"; then
  read_error=1
elif ! state="$(jq -ers '
  if length == 1 and (.[0] | type) == "object" then
    .[0].BackendState | select(type == "string" and length > 0)
  else error("invalid status")
  end
' <<<"$status" 2>/dev/null)"; then
  read_error=1
fi

if (( read_error )); then
  text="off"
  tooltip="Tailscale: daemon not running or status unreadable"
  class="error"
elif [[ "$state" == "Running" ]]; then
  text="on"
  tooltip="Tailscale: connected"
  class="connected"
else
  text="off"
  tooltip="Tailscale: $state"
  class="disconnected"
fi

jq -nc --arg text "$text" --arg tooltip "$tooltip" --arg class "$class" \
  '{text: $text, tooltip: $tooltip, class: $class, alt: $class}'
