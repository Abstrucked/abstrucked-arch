{
    "exec": "tailscale-status",
    "return-type": "json",
    "interval": 15,
    "format": "{icon}",
    "format-icons": {
        "connected": "<span color='{{fg}}'>󰖂</span>",
        "disconnected": "<span color='{{muted}}'>󰖂</span>",
        "error": "<span color='{{muted}}'>󰖂</span>"
    },
    "on-click": "tailscale-menu",
    "on-click-right": "tailscale-toggle",
    "tooltip": true
}
