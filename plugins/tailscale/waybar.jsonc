{
    "exec": "tailscale-status",
    "return-type": "json",
    "interval": 15,
    "format": "{icon} {text}",
    "format-icons": {
        "connected": "<span color='{{magenta}}'>󰤨</span>",
        "disconnected": "<span color='{{magenta}}'>󰤭</span>"
    },
    "on-click": "tailscale-menu",
    "on-click-right": "tailscale-toggle",
    "tooltip": true
}
