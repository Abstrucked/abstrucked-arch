#!/bin/bash
# pluginctl - enable/disable optional widgets (waybar modules, hyprland
# bindings, awesome widgets, helper scripts) built on top of this dotfiles
# stack.
set -euo pipefail
shopt -s nullglob

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
PLUGIN_DIR="$(dirname "$SELF")"
DOTFILES_DIR="$(dirname "$PLUGIN_DIR")"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/plugins"
STATE_FILE="$STATE_DIR/enabled"
BASE_TPL="$DOTFILES_DIR/themes/templates/waybar-config.jsonc.base.tpl"
GEN_TPL="$DOTFILES_DIR/themes/templates/waybar-config.jsonc.tpl"
JSONC_VALIDATOR="$DOTFILES_DIR/scripts/config_syntax.py"
XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
HYPR_PLUGINS_LUA="$XDG_CONFIG_HOME/hypr/lua/plugins.lua"
AWESOME_PLUGINS_LUA="$XDG_CONFIG_HOME/awesome/plugins.lua"
BIN_DIR="$HOME/.local/bin"
# Readers take one in-memory snapshot and never create locks or staging files.
ENABLED_IDS=()
WORK=""
PENDING=false
APPLIED=0
UPDATE_STATE=false
DESTINATIONS=()
PAYLOADS=()
TEMP_DIRS=()

usage() {
  cat <<USAGE
Usage: pluginctl <command> [args]

  list             List discovered plugins and whether each is enabled
  enable <id>      Enable a plugin and reload
  disable <id>     Disable a plugin and reload
  refresh          Regenerate plugin wiring without reloading
  template-waybar  Print the Waybar template without changing files
USAGE
}

die() {
  echo "pluginctl: $*" >&2
  exit 1
}

# Every directory under plugins/ with a manifest.conf is a plugin, id == dirname.
plugin_ids() {
  local d id
  for d in "$PLUGIN_DIR"/*/; do
    [[ -f "$d/manifest.conf" ]] || continue
    id="${d%/}"
    id="${id##*/}"
    [[ "$id" =~ ^[A-Za-z0-9_-]+$ ]] || die "invalid discovered plugin id '$id'"
    printf '%s\n' "$id"
  done
}

manifest_get() {
  local id="$1" requested="$2" line key value number=0
  local assignment='^[[:space:]]*([A-Z][A-Z0-9_]*)[[:space:]]*=[[:space:]]*(.*)$'
  local double_quoted='^"([^"]*)"[[:space:]]*(#.*)?$'
  local single_quoted="^'([^']*)'[[:space:]]*(#.*)?$"
  local unquoted='^([A-Za-z0-9_./#-]*)[[:space:]]*(#.*)?$'
  local -A values=()
  [[ "$id" =~ ^[A-Za-z0-9_-]+$ ]] || die "invalid plugin id '$id'"
  [[ -r "$PLUGIN_DIR/$id/manifest.conf" ]] || die "$id: cannot read manifest.conf"
  # Manifests are data, not executable shell. Quotes delimit literal values;
  # substitutions and shell escape sequences are never evaluated.
  while IFS= read -r line || [[ -n "$line" ]]; do
    number=$((number + 1))
    [[ -z "${line//[[:space:]]/}" || "$line" =~ ^[[:space:]]*# ]] && continue
    [[ "$line" =~ $assignment ]] || die "$id: invalid manifest assignment at line $number"
    key="${BASH_REMATCH[1]}"
    value="${BASH_REMATCH[2]}"
    case "$key" in
      NAME|WAYBAR_MODULE|WAYBAR_SECTION) ;;
      *) die "$id: unknown manifest key '$key' at line $number" ;;
    esac
    [[ -z "${values[$key]+present}" ]] || die "$id: duplicate manifest key '$key' at line $number"
    if [[ "$value" =~ $double_quoted || "$value" =~ $single_quoted || "$value" =~ $unquoted ]]; then
      values[$key]="${BASH_REMATCH[1]}"
    else
      die "$id: invalid literal manifest value at line $number"
    fi
  done <"$PLUGIN_DIR/$id/manifest.conf"
  printf '%s\n' "${values[$requested]:-}"
}

load_state() {
  ENABLED_IDS=()
  if [[ -e "$STATE_FILE" || -L "$STATE_FILE" ]]; then
    [[ -r "$STATE_FILE" ]] || die "cannot read $STATE_FILE"
    mapfile -t ENABLED_IDS <"$STATE_FILE"
  fi
}

enabled_ids() {
  local id
  for id in "${ENABLED_IDS[@]}"; do
    [[ -z "$id" ]] || printf '%s\n' "$id"
  done
}

is_enabled() {
  local id
  for id in "${ENABLED_IDS[@]}"; do
    [[ "$id" != "$1" ]] || return 0
  done
  return 1
}

validate_enabled() {
  local id
  for id in "${ENABLED_IDS[@]}"; do
    [[ -n "$id" ]] || continue
    [[ "$id" =~ ^[A-Za-z0-9_-]+$ ]] || die "invalid plugin id '$id' in enabled state"
    [[ -f "$PLUGIN_DIR/$id/manifest.conf" ]] || die "unknown enabled plugin '$id'"
  done
}

list() {
  local id mark name discovered
  discovered="$(plugin_ids)" || return 1
  while IFS= read -r id; do
    [[ -n "$id" ]] || continue
    name="$(manifest_get "$id" NAME)" || return 1
    if is_enabled "$id"; then mark="[x]"; else mark="[ ]"; fi
    printf '%s %-20s %s\n' "$mark" "$id" "$name"
  done <<<"$discovered"
}

check_waybar_jsonc() {
  local mode="$1" file="$2"
  command -v python3 >/dev/null || die "Waybar validation requires Python 3.11+"
  [[ -r "$JSONC_VALIDATOR" ]] || die "missing JSONC validator $JSONC_VALIDATOR"
  python3 -B "$JSONC_VALIDATOR" --jsonc "$mode" "$file" || die "invalid Waybar JSONC in $file"
}

# Rebuild the generated waybar template by splicing enabled plugins' module
# ids into %%PLUGIN_MODULES_LEFT/CENTER/RIGHT%% (per WAYBAR_SECTION, default
# right) and their defs into %%PLUGIN_DEFS%%, all markers in the base
# template. An optional waybar-defs.jsonc adds further "name": {...} defs,
# for modules WAYBAR_MODULE refers to, such as the members of a group. themectl's
# normal render pipeline treats the result like any other template, so it
# stays unaware plugins exist at all.
sync_waybar() {
  [[ -r "$BASE_TPL" ]] || die "missing $BASE_TPL"
  local tpl defs="" left="" center="" right="" id module section frag
  tpl="$(cat "$BASE_TPL")"
  while IFS= read -r id; do
    [[ -n "$id" ]] || continue
    [[ -f "$PLUGIN_DIR/$id/waybar.jsonc" ]] || continue
    module="$(manifest_get "$id" WAYBAR_MODULE)"
    [[ -n "$module" ]] || die "$id: waybar.jsonc present but WAYBAR_MODULE not set in manifest.conf"
    [[ "$module" =~ ^[A-Za-z0-9_./#-]+$ ]] || die "$id: invalid WAYBAR_MODULE name"
    section="$(manifest_get "$id" WAYBAR_SECTION)"
    check_waybar_jsonc --object "$PLUGIN_DIR/$id/waybar.jsonc"
    frag="$(cat "$PLUGIN_DIR/$id/waybar.jsonc")"
    defs+=$',\n    "'"$module"'": '"$frag"
    if [[ -f "$PLUGIN_DIR/$id/waybar-defs.jsonc" ]]; then
      check_waybar_jsonc --fragment "$PLUGIN_DIR/$id/waybar-defs.jsonc"
      defs+=$',\n    '"$(cat "$PLUGIN_DIR/$id/waybar-defs.jsonc")"
    fi
    case "${section:-right}" in
      left) left+=$',\n        "'"$module"'"' ;;
      center) center+=$',\n        "'"$module"'"' ;;
      right) right+=$',\n        "'"$module"'"' ;;
      *) die "$id: unknown WAYBAR_SECTION '$section' (want left, center or right)" ;;
    esac
  done < <(enabled_ids)
  tpl="${tpl//%%PLUGIN_MODULES_LEFT%%/"$left"}"
  tpl="${tpl//%%PLUGIN_MODULES_CENTER%%/"$center"}"
  tpl="${tpl//%%PLUGIN_MODULES_RIGHT%%/"$right"}"
  tpl="${tpl//%%PLUGIN_DEFS%%/"$defs"}"
  check_waybar_jsonc --object /dev/stdin <<<"$tpl"
  if [[ "${1:-}" == stdout ]]; then
    printf '%s\n' "$tpl"
  else
    printf '%s\n' "$tpl" >"$WORK/waybar.tpl"
  fi
}

# hyprland.lua requires("./lua/plugins") unconditionally, so this must
# always exist, even as an empty module, with zero plugins enabled. Each
# fragment runs in its own pcall, so one that errors at load time is logged
# and skipped instead of aborting the rest of the plugins.
sync_hypr() {
  local id
  : >"$WORK/hypr.lua"
  while IFS= read -r id; do
    [[ -n "$id" ]] || continue
    [[ -f "$PLUGIN_DIR/$id/hypr.lua" ]] || continue
    {
      echo "-- plugin: $id"
      echo "do"
      echo "local ok, err = pcall(function()"
      cat "$PLUGIN_DIR/$id/hypr.lua"
      echo
      echo "end)"
      echo "if not ok then"
      echo "print(\"pluginctl: plugin $id failed: \" .. tostring(err))"
      echo "hl.exec_cmd(\"notify-send -u critical 'Plugin $id failed' 'See the Hyprland log'\")"
      echo "end"
      echo "end"
      echo
    } >>"$WORK/hypr.lua"
  done < <(enabled_ids)
  check_lua_syntax luac "$WORK/hypr.lua"
}

# theme.lua calls require("plugins")(left_widgets, right_widgets, pl, c, s)
# once per connected screen while building the wibar, so this must always
# exist, even as a no-op function, with zero plugins enabled. Unlike
# waybar.jsonc (static JSON), an awesome.lua fragment is arbitrary Lua with
# left_widgets/right_widgets/pl/c/s/once in scope and must table.insert its
# own widget into whichever table it wants, same as the built-ins do.
#
# Each fragment becomes its own function run under pcall: one that errors
# gets whatever it already inserted rolled back and a notification, and the
# other plugins and the rest of the bar still load. once(build) runs build on
# the first screen and hands the same widget to every later one, the way the
# built-in widgets are shared, so a watch command isn't polled once per
# monitor.
sync_awesome() {
  local id
  {
    echo "-- generated by plugins/pluginctl; may be a no-op"
    echo "local awful = require(\"awful\")"
    echo "local gears = require(\"gears\")"
    echo "local naughty = require(\"naughty\")"
    echo
    echo "local plugins = {}"
    echo
    while IFS= read -r id; do
      [[ -n "$id" ]] || continue
      [[ -f "$PLUGIN_DIR/$id/awesome.lua" ]] || continue
      echo "-- plugin: $id"
      echo "plugins[#plugins + 1] = { id = \"$id\", run = function(left_widgets, right_widgets, pl, c, s, once)"
      cat "$PLUGIN_DIR/$id/awesome.lua"
      echo
      echo "end }"
      echo
    done < <(enabled_ids)
    cat <<'LUA'
local shared, reported = {}, {}

local function truncate(t, n)
	for i = #t, n + 1, -1 do
		t[i] = nil
	end
end

return function(left_widgets, right_widgets, pl, c, s)
	for _, plugin in ipairs(plugins) do
		local slots = shared[plugin.id] or {}
		shared[plugin.id] = slots
		local n = 0
		local function once(build)
			n = n + 1
			if slots[n] == nil then
				slots[n] = build()
			end
			return slots[n]
		end
		local nleft, nright = #left_widgets, #right_widgets
		local ok, err = pcall(plugin.run, left_widgets, right_widgets, pl, c, s, once)
		if not ok then
			truncate(left_widgets, nleft)
			truncate(right_widgets, nright)
			if not reported[plugin.id] then
				reported[plugin.id] = true
				naughty.notify({
					preset = naughty.config.presets.critical,
					title = "Plugin " .. plugin.id .. " failed",
					text = tostring(err),
				})
			end
		end
	end
end
LUA
  } >"$WORK/awesome.lua"
  check_lua_syntax awesome "$WORK/awesome.lua"
}

# A syntax error can't be caught by the pcalls above, since it stops the whole
# generated file from loading, so reject it here instead. Awesome's own check
# uses the Lua it runs with; Hyprland's side falls back to whatever luac is on
# PATH. Either is skipped if the tool isn't installed.
check_lua_syntax() {
  local tool="$1" file="$2" out
  case "$tool" in
    awesome)
      command -v awesome >/dev/null || return 0
      out="$(awesome --check --config "$file" 2>&1)" || die "generated $(basename "$file") has a syntax error:"$'\n'"$out"
      ;;
    luac)
      command -v luac >/dev/null || return 0
      out="$(luac -p "$file" 2>&1)" || die "generated $(basename "$file") has a syntax error:"$'\n'"$out"
      ;;
  esac
}

# Only links naming a plugin helper belong to us, including helpers whose
# plugin has since been removed. Never delete another application's symlink.
owned_bin_link() {
  local dest="$1" target relative id
  [[ -L "$dest" ]] || return 1
  target="$(readlink "$dest")"
  [[ "$target" == /* ]] || target="$(dirname "$dest")/$target"
  target="$(realpath -ms -- "$target")"
  [[ "$target" == "$PLUGIN_DIR/"* ]] || return 1
  relative="${target#"$PLUGIN_DIR/"}"
  id="${relative%%/*}"
  [[ "$id" =~ ^[A-Za-z0-9_-]+$ && "$relative" == "$id/bin/$(basename "$dest")" ]]
}

# Check every incoming helper and stage only owned link changes. Empty bin
# directories are harmless; duplicate helper names are rejected before writes.
sync_bin() {
  local id f base
  local -A incoming=()
  while IFS= read -r id; do
    [[ -n "$id" ]] || continue
    for f in "$PLUGIN_DIR/$id/bin"/*; do
      [[ -f "$f" ]] || continue
      base="$(basename "$f")"
      [[ -z "${incoming[$base]:-}" ]] || die "multiple plugins provide '$base'"
      incoming[$base]="$f"
      if [[ -e "$BIN_DIR/$base" || -L "$BIN_DIR/$base" ]]; then
        owned_bin_link "$BIN_DIR/$base" || die "refusing to replace unrelated command $BIN_DIR/$base"
      fi
    done
  done < <(enabled_ids)
  for f in "$BIN_DIR"/*; do
    base="$(basename "$f")"
    if owned_bin_link "$f" && [[ -z "${incoming[$base]:-}" ]]; then
      DESTINATIONS+=("$f")
      PAYLOADS+=("-")
    fi
  done
  while IFS= read -r id; do
    [[ -n "$id" ]] || continue
    for f in "$PLUGIN_DIR/$id/bin"/*; do
      [[ -f "$f" ]] || continue
      base="$(basename "$f")"
      ln -s -- "$f" "$WORK/bin/$base"
      DESTINATIONS+=("$BIN_DIR/$base")
      PAYLOADS+=("$WORK/bin/$base")
    done
  done < <(enabled_ids)
}

# Stage beside each destination so publication is an atomic rename even when
# the repository, home and state directory live on different filesystems.
replace_target() {
  local source="$1" dest="$2" temp
  if [[ "$source" == "-" ]]; then
    rm -f -- "$dest"
    return
  fi
  mkdir -p -- "$(dirname "$dest")" || return 1
  temp="$(mktemp -d "$(dirname "$dest")/.pluginctl.XXXXXXXX")" || return 1
  TEMP_DIRS+=("$temp")
  cp -a -- "$source" "$temp/item" || return 1
  mv -Tf -- "$temp/item" "$dest" || return 1
}

rollback() {
  local i failed=false
  for ((i = APPLIED - 1; i >= 0; i--)); do
    if [[ -e "$WORK/previous/$i" || -L "$WORK/previous/$i" ]]; then
      replace_target "$WORK/previous/$i" "${DESTINATIONS[$i]}" || failed=true
    else
      rm -f -- "${DESTINATIONS[$i]}" || failed=true
    fi
  done
  [[ "$failed" == false ]]
}

finish_mutation() {
  local status=$? temp keep=false
  trap - EXIT
  if [[ "$PENDING" == true ]]; then
    if ! rollback; then
      echo "pluginctl: rollback failed; recovery copies retained at $WORK/previous" >&2
      keep=true
      status=1
    fi
  fi
  for temp in "${TEMP_DIRS[@]}"; do
    rm -rf -- "$temp" || status=1
  done
  if [[ -n "$WORK" && "$keep" == false ]]; then
    rm -rf -- "$WORK" || status=1
  fi
  exit "$status"
}

begin_mutation() {
  trap finish_mutation EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  # The template is shared by all users of this checkout, not just this home.
  exec 9>"$PLUGIN_DIR/.pluginctl.lock"
  flock -x -w 60 9 || die "timed out waiting for pluginctl lock"
  load_state
}

refresh() {
  WORK="$(mktemp -d "$PLUGIN_DIR/.transaction.XXXXXXXX")"
  mkdir -p "$WORK/previous" "$WORK/bin"
  enabled_ids | sort -u >"$WORK/enabled"
  mapfile -t ENABLED_IDS <"$WORK/enabled"
  validate_enabled
  # Refresh commits the same normalized state that generated wiring uses.
  UPDATE_STATE=true
  DESTINATIONS=("$GEN_TPL" "$HYPR_PLUGINS_LUA" "$AWESOME_PLUGINS_LUA")
  PAYLOADS=("$WORK/waybar.tpl" "$WORK/hypr.lua" "$WORK/awesome.lua")
  sync_bin
  sync_waybar
  sync_hypr
  sync_awesome
  if [[ "$UPDATE_STATE" == true ]]; then
    DESTINATIONS+=("$STATE_FILE")
    PAYLOADS+=("$WORK/enabled")
  fi

  local i dest
  for i in "${!DESTINATIONS[@]}"; do
    dest="${DESTINATIONS[$i]}"
    [[ ! -d "$dest" || -L "$dest" ]] || die "refusing to replace directory $dest"
    if [[ -e "$dest" || -L "$dest" ]]; then
      cp -a -- "$dest" "$WORK/previous/$i"
    fi
  done
  PENDING=true
  for i in "${!DESTINATIONS[@]}"; do
    # Include the attempted operation in rollback in case publication is
    # interrupted immediately after the rename or removal succeeds.
    APPLIED=$((i + 1))
    replace_target "${PAYLOADS[$i]}" "${DESTINATIONS[$i]}" || die "could not update ${DESTINATIONS[$i]}; restoring previous wiring"
  done
  PENDING=false
}

reload_theme() {
  # themectl reads plugin state while holding its own lock. Release ours
  # first to avoid lock inversion and inherited locks in reload helpers.
  exec 9>&-
  "$DOTFILES_DIR/themes/themectl" apply || die "wiring committed, but theme reload failed; rerun themectl apply"
}

enable() {
  local id="$1"
  # The id is spliced into generated Lua and shell strings.
  [[ "$id" =~ ^[A-Za-z0-9_-]+$ ]] || die "invalid plugin id '$id' (letters, digits, - and _ only)"
  [[ -f "$PLUGIN_DIR/$id/manifest.conf" ]] || die "unknown plugin '$id' (try: pluginctl list)"
  is_enabled "$id" && {
    echo "already enabled: $id"
    return
  }
  ENABLED_IDS+=("$id")
  UPDATE_STATE=true
  refresh
  reload_theme
  echo "enabled: $id"
}

disable() {
  local id="$1"
  [[ "$id" =~ ^[A-Za-z0-9_-]+$ ]] || die "invalid plugin id '$id' (letters, digits, - and _ only)"
  is_enabled "$id" || {
    echo "not enabled: $id"
    return
  }
  local enabled remaining=()
  for enabled in "${ENABLED_IDS[@]}"; do
    [[ "$enabled" == "$id" ]] || remaining+=("$enabled")
  done
  ENABLED_IDS=("${remaining[@]}")
  UPDATE_STATE=true
  refresh
  reload_theme
  echo "disabled: $id"
}

cmd="${1:-}"
case "$cmd" in
  enable | disable | refresh) begin_mutation ;;
  list | template-waybar) load_state ;;
esac
case "$cmd" in
  list) list ;;
  enable)
    [[ -n "${2:-}" ]] || die "usage: pluginctl enable <id>"
    enable "$2"
    ;;
  disable)
    [[ -n "${2:-}" ]] || die "usage: pluginctl disable <id>"
    disable "$2"
    ;;
  refresh) refresh ;;
  template-waybar)
    validate_enabled
    sync_waybar stdout
    ;;
  "" | -h | --help | help) usage ;;
  *)
    usage >&2
    exit 2
    ;;
esac
