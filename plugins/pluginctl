#!/bin/bash
# pluginctl - enable/disable optional widgets (waybar modules, hyprland
# bindings, awesome widgets, helper scripts) built on top of this dotfiles
# stack.
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
PLUGIN_DIR="$(dirname "$SELF")"
DOTFILES_DIR="$(dirname "$PLUGIN_DIR")"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/plugins"
STATE_FILE="$STATE_DIR/enabled"
BASE_TPL="$DOTFILES_DIR/themes/templates/waybar-config.jsonc.base.tpl"
GEN_TPL="$DOTFILES_DIR/themes/templates/waybar-config.jsonc.tpl"
HYPR_PLUGINS_LUA="$HOME/.config/hypr/lua/plugins.lua"
AWESOME_PLUGINS_LUA="$HOME/.config/awesome/plugins.lua"
BIN_DIR="$HOME/.local/bin"
# What sync_* read as the enabled set. enable/disable point this at the
# candidate state so a plugin that fails to wire is never recorded as on.
ENABLED_SOURCE="$STATE_FILE"

# Generated files are staged as .new and only moved into place by commit_generated
# once every one of them has been built and checked, so a failure part-way
# through leaves the live wiring (and the recorded state) as it was.
trap 'rm -f "$GEN_TPL.new" "$HYPR_PLUGINS_LUA.new" "$AWESOME_PLUGINS_LUA.new" "$STATE_FILE.new"' EXIT

usage() {
  cat <<USAGE
Usage: pluginctl <command> [args]

  list             List discovered plugins and whether each is enabled
  enable <id>      Enable a plugin and reload
  disable <id>     Disable a plugin and reload
  refresh          Regenerate plugin wiring without reloading
  template-waybar  Print the Waybar template without changing files
USAGE
}

die() { echo "pluginctl: $*" >&2; exit 1; }

# Every directory under plugins/ with a manifest.conf is a plugin, id == dirname.
plugin_ids() {
  local d
  for d in "$PLUGIN_DIR"/*/; do
    [[ -f "$d/manifest.conf" ]] && basename "$d"
  done
}

manifest_get() {
  local id="$1" key="$2"
  ( . "$PLUGIN_DIR/$id/manifest.conf"; echo "${!key:-}" )
}

enabled_ids() { [[ -r "$ENABLED_SOURCE" ]] && cat "$ENABLED_SOURCE" || true; }

is_enabled() { [[ -r "$STATE_FILE" ]] && grep -qxF "$1" "$STATE_FILE"; }

list() {
  local id mark
  for id in $(plugin_ids); do
    if is_enabled "$id"; then mark="[x]"; else mark="[ ]"; fi
    printf '%s %-20s %s\n' "$mark" "$id" "$(manifest_get "$id" NAME)"
  done
}

# Rebuild the generated waybar template by splicing enabled plugins' module
# ids into %%PLUGIN_MODULES_LEFT/CENTER/RIGHT%% (per WAYBAR_SECTION, default
# right) and their defs into %%PLUGIN_DEFS%%, all markers in the base
# template. themectl's normal render pipeline treats the result like any
# other template, so it stays unaware plugins exist at all.
sync_waybar() {
  [[ -r "$BASE_TPL" ]] || die "missing $BASE_TPL"
  local tpl defs="" left="" center="" right="" id module section frag
  tpl="$(cat "$BASE_TPL")"
  for id in $(enabled_ids); do
    [[ -f "$PLUGIN_DIR/$id/waybar.jsonc" ]] || continue
    module="$(manifest_get "$id" WAYBAR_MODULE)"
    [[ -n "$module" ]] || die "$id: waybar.jsonc present but WAYBAR_MODULE not set in manifest.conf"
    section="$(manifest_get "$id" WAYBAR_SECTION)"
    frag="$(cat "$PLUGIN_DIR/$id/waybar.jsonc")"
    defs+=$',\n    "'"$module"'": '"$frag"
    case "${section:-right}" in
      left) left+=$',\n        "'"$module"'"' ;;
      center) center+=$',\n        "'"$module"'"' ;;
      right) right+=$',\n        "'"$module"'"' ;;
      *) die "$id: unknown WAYBAR_SECTION '$section' (want left, center or right)" ;;
    esac
  done
  tpl="${tpl//%%PLUGIN_MODULES_LEFT%%/$left}"
  tpl="${tpl//%%PLUGIN_MODULES_CENTER%%/$center}"
  tpl="${tpl//%%PLUGIN_MODULES_RIGHT%%/$right}"
  tpl="${tpl//%%PLUGIN_DEFS%%/$defs}"
  if [[ "${1:-}" == stdout ]]; then
    printf '%s\n' "$tpl"
  else
    printf '%s\n' "$tpl" >"$GEN_TPL.new"
  fi
}

# hyprland.lua requires("./lua/plugins") unconditionally, so this must
# always exist, even as an empty module, with zero plugins enabled. Each
# fragment runs in its own pcall, so one that errors at load time is logged
# and skipped instead of aborting the rest of the plugins.
sync_hypr() {
  local id
  mkdir -p "$(dirname "$HYPR_PLUGINS_LUA")"
  : >"$HYPR_PLUGINS_LUA.new"
  for id in $(enabled_ids); do
    [[ -f "$PLUGIN_DIR/$id/hypr.lua" ]] || continue
    {
      echo "-- plugin: $id"
      echo "do"
      echo "local ok, err = pcall(function()"
      cat "$PLUGIN_DIR/$id/hypr.lua"
      echo
      echo "end)"
      echo "if not ok then"
      echo "print(\"pluginctl: plugin $id failed: \" .. tostring(err))"
      echo "hl.exec_cmd(\"notify-send -u critical 'Plugin $id failed' 'See the Hyprland log'\")"
      echo "end"
      echo "end"
      echo
    } >>"$HYPR_PLUGINS_LUA.new"
  done
  check_lua_syntax luac "$HYPR_PLUGINS_LUA.new"
}

# theme.lua calls require("plugins")(left_widgets, right_widgets, pl, c, s)
# once per connected screen while building the wibar, so this must always
# exist, even as a no-op function, with zero plugins enabled. Unlike
# waybar.jsonc (static JSON), an awesome.lua fragment is arbitrary Lua with
# left_widgets/right_widgets/pl/c/s/once in scope and must table.insert its
# own widget into whichever table it wants, same as the built-ins do.
#
# Each fragment becomes its own function run under pcall: one that errors
# gets whatever it already inserted rolled back and a notification, and the
# other plugins and the rest of the bar still load. once(build) runs build on
# the first screen and hands the same widget to every later one, the way the
# built-in widgets are shared, so a watch command isn't polled once per
# monitor.
sync_awesome() {
  local id
  mkdir -p "$(dirname "$AWESOME_PLUGINS_LUA")"
  {
    echo "-- generated by plugins/pluginctl; may be a no-op"
    echo "local awful = require(\"awful\")"
    echo "local gears = require(\"gears\")"
    echo "local naughty = require(\"naughty\")"
    echo
    echo "local plugins = {}"
    echo
    for id in $(enabled_ids); do
      [[ -f "$PLUGIN_DIR/$id/awesome.lua" ]] || continue
      echo "-- plugin: $id"
      echo "plugins[#plugins + 1] = { id = \"$id\", run = function(left_widgets, right_widgets, pl, c, s, once)"
      cat "$PLUGIN_DIR/$id/awesome.lua"
      echo
      echo "end }"
      echo
    done
    cat <<'LUA'
local shared, reported = {}, {}

local function truncate(t, n)
	for i = #t, n + 1, -1 do
		t[i] = nil
	end
end

return function(left_widgets, right_widgets, pl, c, s)
	for _, plugin in ipairs(plugins) do
		local slots = shared[plugin.id] or {}
		shared[plugin.id] = slots
		local n = 0
		local function once(build)
			n = n + 1
			if slots[n] == nil then
				slots[n] = build()
			end
			return slots[n]
		end
		local nleft, nright = #left_widgets, #right_widgets
		local ok, err = pcall(plugin.run, left_widgets, right_widgets, pl, c, s, once)
		if not ok then
			truncate(left_widgets, nleft)
			truncate(right_widgets, nright)
			if not reported[plugin.id] then
				reported[plugin.id] = true
				naughty.notify({
					preset = naughty.config.presets.critical,
					title = "Plugin " .. plugin.id .. " failed",
					text = tostring(err),
				})
			end
		end
	end
end
LUA
  } >"$AWESOME_PLUGINS_LUA.new"
  check_lua_syntax awesome "$AWESOME_PLUGINS_LUA.new"
}

# A syntax error can't be caught by the pcalls above, since it stops the whole
# generated file from loading, so reject it here instead. Awesome's own check
# uses the Lua it runs with; Hyprland's side falls back to whatever luac is on
# PATH. Either is skipped if the tool isn't installed.
check_lua_syntax() {
  local tool="$1" file="$2" out
  case "$tool" in
    awesome)
      command -v awesome >/dev/null || return 0
      out="$(awesome --check --config "$file" 2>&1)" || die "generated $(basename "$file") has a syntax error:"$'\n'"$out"
      ;;
    luac)
      command -v luac >/dev/null || return 0
      out="$(luac -p "$file" 2>&1)" || die "generated $(basename "$file") has a syntax error:"$'\n'"$out"
      ;;
  esac
}

commit_generated() {
  mv "$GEN_TPL.new" "$GEN_TPL"
  mv "$HYPR_PLUGINS_LUA.new" "$HYPR_PLUGINS_LUA"
  mv "$AWESOME_PLUGINS_LUA.new" "$AWESOME_PLUGINS_LUA"
}

# Symlink each enabled plugin's bin/* into ~/.local/bin, dropping symlinks
# for anything no longer enabled.
sync_bin() {
  local id f base
  for id in $(plugin_ids); do
    [[ -d "$PLUGIN_DIR/$id/bin" ]] || continue
    for f in "$PLUGIN_DIR/$id/bin"/*; do
      base="$(basename "$f")"
      [[ -L "$BIN_DIR/$base" ]] && rm -f "$BIN_DIR/$base"
    done
  done
  for id in $(enabled_ids); do
    [[ -d "$PLUGIN_DIR/$id/bin" ]] || continue
    mkdir -p "$BIN_DIR"
    for f in "$PLUGIN_DIR/$id/bin"/*; do
      ln -sf "$f" "$BIN_DIR/$(basename "$f")"
    done
  done
}

refresh() {
  sync_waybar
  sync_hypr
  sync_awesome
  commit_generated
  sync_bin
}

# Stage the new enabled list, wire it up, and only then record it. If any sync
# dies, the EXIT trap drops the staged list and the plugin stays off.
apply_state() {
  mkdir -p "$STATE_DIR"
  sort -u >"$STATE_FILE.new"
  ENABLED_SOURCE="$STATE_FILE.new"
  refresh
  mv "$STATE_FILE.new" "$STATE_FILE"
}

enable() {
  local id="$1"
  [[ -f "$PLUGIN_DIR/$id/manifest.conf" ]] || die "unknown plugin '$id' (try: pluginctl list)"
  # The id is spliced into generated Lua and shell strings.
  [[ "$id" =~ ^[A-Za-z0-9_-]+$ ]] || die "invalid plugin id '$id' (letters, digits, - and _ only)"
  is_enabled "$id" && { echo "already enabled: $id"; return; }
  apply_state < <(enabled_ids; echo "$id")
  "$DOTFILES_DIR/themes/themectl" apply
  echo "enabled: $id"
}

disable() {
  local id="$1"
  is_enabled "$id" || { echo "not enabled: $id"; return; }
  apply_state < <(grep -vxF "$id" "$STATE_FILE" || true)
  "$DOTFILES_DIR/themes/themectl" apply
  echo "disabled: $id"
}

cmd="${1:-}"
case "$cmd" in
  list) list ;;
  enable) [[ -n "${2:-}" ]] || die "usage: pluginctl enable <id>"; enable "$2" ;;
  disable) [[ -n "${2:-}" ]] || die "usage: pluginctl disable <id>"; disable "$2" ;;
  refresh) refresh ;;
  template-waybar) sync_waybar stdout ;;
  ""|-h|--help|help) usage ;;
  *) usage >&2; exit 2 ;;
esac
