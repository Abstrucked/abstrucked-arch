#!/bin/sh
# Prints the active AI provider's plan usage or OpenRouter balance for the bars:
#   --waybar        custom-module JSON: session percentage or credit balance, with
#                   ai-usagebar's usage class for the stylesheet to colour
#   --awesome       JSON for the awesome.lua widget: the value plus the
#                   path of the provider's logo in ../icons
#   --icon COLOR    the path of the provider's logo recoloured to COLOR, for
#                   waybar's image module; empty for a vendor without one
#   (no option)     a plain one-line string
# In the first two the logo stands in for the vendor name, and the reset time
# is left to the tooltip; a vendor without a logo keeps its short name. Any
# further arguments are passed to ai-usagebar.
# Requires: ai-usagebar, jq.
#
# ai-usagebar renders for a human when stdout is a TTY, so --json is passed
# explicitly rather than relying on it detecting the bar.
set -eu

FORMAT='{vendor_short} {session_pct}% · {session_reset}'
FALLBACK='ai ?'
PLUGIN_DIR="$(dirname "$(dirname "$(readlink -f "$0")")")"
ICONS="$PLUGIN_DIR/icons"

# ai-usagebar's short vendor name -> logo in $ICONS.
LOGOS='{"cld": "claude", "gpt": "openai", "cdx": "openai", "ghc": "copilot"}'

mode=plain
case "${1:-}" in
--waybar | --awesome)
    mode="${1#--}"
    FORMAT='{vendor_short} {session_pct}%'
    shift
    ;;
--icon)
    # Reads the active vendor from local settings, so it costs no request
    # against the rate-limited usage endpoints.
    color="${2:?usage: ai-usage-text --icon '#rrggbb'}"
    vendor="$(ai-usagebar settings show 2>/dev/null | jq -r '.primary // empty')" || vendor=''
    case "$vendor" in
    anthropic) logo=claude ;;
    openai) logo=openai ;;
    copilot) logo=copilot ;;
    *) exit 0 ;;
    esac
    cache="${XDG_CACHE_HOME:-$HOME/.cache}/ai-usagebar"
    out="$cache/$logo-${color#\#}.svg"
    if [ ! -s "$out" ]; then
        mkdir -p "$cache"
        tmp="$(mktemp "$cache/.tmp.XXXXXXXX")"
        trap 'rm -f "$tmp"' EXIT
        sed -e "s/fill=\"black\"/fill=\"$color\"/g" -e "s/stroke=\"black\"/stroke=\"$color\"/g" "$ICONS/$logo.svg" >"$tmp"
        mv -f "$tmp" "$out"
        trap - EXIT
    fi
    printf '%s\n' "$out"
    exit 0
    ;;
esac

# Select the appropriate format, including explicit CLI vendor overrides.
vendor="$(ai-usagebar settings show 2>/dev/null | jq -r '.primary // "anthropic"')" || vendor=anthropic
previous_arg=''
for arg in "$@"; do
    if [ "$previous_arg" = --vendor ]; then
        vendor="$arg"
    fi
    case "$arg" in --vendor=*) vendor="${arg#--vendor=}" ;; esac
    previous_arg="$arg"
done

if [ "$vendor" = openrouter ]; then
    # shellcheck source=../lib/openrouter-key.sh
    . "$PLUGIN_DIR/lib/openrouter-key.sh"
    if ai_usage_load_openrouter_key background; then
        # shellcheck disable=SC2016 # ${or_balance} is ai-usagebar's placeholder
        FORMAT='{vendor_short} ${or_balance}'
    else
        key_status=$?
        label='opr locked'
        message='OpenRouter key is locked or unavailable. Click to open the dashboard and unlock it.'
        if [ "$key_status" -eq 2 ]; then
            label='opr ?'
            message='OpenRouter key is missing. Store it in pass as ai/openrouter_api_key.'
        fi
        if [ "$mode" = plain ]; then
            printf '%s\n' "$label"
        else
            jq -cn --arg text "$label" --arg tooltip "$message" \
                '{text: $text, tooltip: $tooltip, class: "unavailable", icon: ""}'
        fi
        exit 0
    fi
fi

json=''
if ! json="$(ai-usagebar --json --format "$FORMAT" "$@" 2>/dev/null)" || [ -z "$json" ]; then
    # A missing binary or an unreachable vendor must not empty the bar.
    if [ "$mode" != plain ]; then
        printf '{"text":"%s","tooltip":"ai-usagebar: no usage available","class":"unavailable"}\n' "$FALLBACK"
    else
        printf '%s\n' "$FALLBACK"
    fi
    exit 0
fi

case "$mode" in
waybar | awesome)
    # The bars colour the text themselves, so drop ai-usagebar's Pango span.
    printf '%s\n' "$json" | jq -c --arg mode "$mode" --arg icons "$ICONS" --argjson logos "$LOGOS" '
        (.text | gsub("<[^>]*>"; "") | split(" ")) as [$vendor, $pct]
        | $logos[$vendor] as $logo
        | {
            text: (if $logo then $pct else "\($vendor) \($pct)" end),
            tooltip: .tooltip,
            class: .class
          }
        + (if $mode == "awesome" then {icon: (if $logo then "\($icons)/\($logo).svg" else "" end)} else {} end)'
    ;;
*)
    printf '%s\n' "$json" | jq -r --arg fallback "$FALLBACK" '(.text // $fallback) | gsub("<[^>]*>"; "")'
    ;;
esac
