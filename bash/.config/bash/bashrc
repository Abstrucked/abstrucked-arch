# shellcheck shell=bash
# Shared environment defaults
# shellcheck source=../../../scripts/.config/shell/env.sh
source "${XDG_CONFIG_HOME:-$HOME/.config}/shell/env.sh"

# Starship prompt
eval "$(starship init bash)"

# Source custom aliases
# shellcheck source=aliases.sh
source "${XDG_CONFIG_HOME:-$HOME/.config}/bash/aliases.sh"

# Keybindings

# Home key (go to beginning of line)
bind '"\e[H": beginning-of-line'

# End key (go to end of line)
bind '"\e[F": end-of-line'

# Ctrl + Left (backward-word)
bind '"\e[1;5D": backward-word'
bind '"\e[5D": backward-word'

# Ctrl + Right (forward-word)
bind '"\e[1;5C": forward-word'
bind '"\e[5C": forward-word'

# History
HISTFILE=~/.bash_history
HISTSIZE=10000
HISTFILESIZE=10000
shopt -s histappend

###-begin-pm2-completion-###
### credits to npm for the completion file model
#
# Installation: pm2 completion >> ~/.bashrc
#

COMP_WORDBREAKS=${COMP_WORDBREAKS/=/}
COMP_WORDBREAKS=${COMP_WORDBREAKS/@/}
export COMP_WORDBREAKS

if type complete &>/dev/null; then
  _pm2_completion () {
    local suggestions
    suggestions=$(COMP_CWORD="$COMP_CWORD" \
                  COMP_LINE="$COMP_LINE" \
                  COMP_POINT="$COMP_POINT" \
                  pm2 completion -- "${COMP_WORDS[@]}" \
                  2>/dev/null) || return $?
    COMPREPLY=()
    [[ -z "$suggestions" ]] || mapfile -t COMPREPLY <<<"$suggestions"
    return 0
  }
  complete -o default -F _pm2_completion pm2
fi
###-end-pm2-completion-###

# asdf completions
if [[ -f "${ASDF_DATA_DIR:-$HOME/.asdf}/completions/asdf.bash" ]]; then
  # shellcheck source=/dev/null # Optional user-installed completion.
  source "${ASDF_DATA_DIR:-$HOME/.asdf}/completions/asdf.bash"
fi

# Local completions
for _completion in "${XDG_CONFIG_HOME:-$HOME/.config}"/bash/completions/*.bash; do
  # shellcheck source=/dev/null # Completion files are selected at runtime.
  [[ -r "$_completion" ]] && source "$_completion"
done
unset _completion
