#!/bin/bash

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Function to print colored output
print_info() {
  echo -e "${BLUE}INFO:${NC} $1"
}

print_success() {
  echo -e "${GREEN}SUCCESS:${NC} $1"
}

print_warning() {
  echo -e "${YELLOW}WARNING:${NC} $1"
}

print_error() {
  echo -e "${RED}ERROR:${NC} $1"
}

# Check if running interactively
if [[ ! -t 0 ]]; then
  print_error "This script must be run interactively."
  exit 1
fi

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"

validate_name() {
  local label="$1"
  local value="$2"
  if [[ ! "$value" =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*$ || "$value" == *..* ]]; then
    print_error "$label must contain only letters, numbers, dots, underscores, plus signs, or hyphens; it cannot contain '..'."
    exit 1
  fi
}

# Prompt for program name
read -r -p "Enter the program name (e.g., nvim, code, cursor): " program
if [[ -z "$program" ]]; then
  print_error "Program name cannot be empty."
  exit 1
fi
validate_name "Program name" "$program"

# Prompt for category
read -r -p "Enter the category (e.g., ai, dev): " category
if [[ -z "$category" ]]; then
  print_error "Category cannot be empty."
  exit 1
fi
validate_name "Category" "$category"

# Define paths
launcher_dir="$HOME/.local/bin"
launcher_file="${launcher_dir}/${program}-launcher"
launcher_dir_real="$(realpath -m "$launcher_dir")"
launcher_file_real="$(realpath -m "$launcher_file")"
case "$launcher_file_real" in
  "$launcher_dir_real"/*) ;;
  *)
    print_error "Launcher path resolves outside $launcher_dir."
    exit 1
    ;;
esac
launcher_file="$launcher_file_real"

if [[ -L "$launcher_file" ]]; then
  print_error "Refusing to overwrite a symbolic-link launcher: $launcher_file"
  exit 1
fi

# Detect which shell is stowed
if [[ -L "$HOME/.bashrc" ]] && [[ "$(realpath -m "$HOME/.bashrc")" == "$DOTFILES_DIR/bash/"* ]]; then
    SHELL_TYPE="bash"
    aliases_file="$DOTFILES_DIR/bash/.config/bash/aliases.sh"
    shell_rc_file="$DOTFILES_DIR/bash/.bashrc"
    source_pattern="source.*aliases.sh"
elif [[ -L "$HOME/.zshrc" ]] && [[ "$(realpath -m "$HOME/.zshrc")" == "$DOTFILES_DIR/zsh/"* ]]; then
    SHELL_TYPE="zsh"
    aliases_file="$DOTFILES_DIR/zsh/.config/zsh/aliases.zsh"
    shell_rc_file="$DOTFILES_DIR/zsh/.zshrc"
    source_pattern="source.*aliases.zsh"
else
    # Default to zsh for backward compatibility
    SHELL_TYPE="zsh"
    aliases_file="$DOTFILES_DIR/zsh/.config/zsh/aliases.zsh"
    shell_rc_file="$DOTFILES_DIR/zsh/.zshrc"
    source_pattern="source.*aliases.zsh"
fi

# Create launcher script
print_info "Creating launcher script: $launcher_file"
if [[ -e "$launcher_file" ]]; then
  backup_file="${launcher_file}.backup.$(date +%Y%m%d%H%M%S)"
  suffix=0
  while [[ -e "$backup_file" ]]; do
    suffix=$((suffix + 1))
    backup_file="${launcher_file}.backup.$(date +%Y%m%d%H%M%S).$suffix"
  done
  cp -p -- "$launcher_file" "$backup_file"
  print_warning "Existing launcher backed up to: $backup_file"
fi
printf -v launch_command '%q' "$program"
launch_flags=""
if [[ "$program" == "opencode" ]]; then
  # OpenCode's shared service does not inherit this launcher's API keys.
  launch_flags=" --standalone"
fi
cat >"$launcher_file" <<EOF
#!/bin/bash

# shellcheck disable=SC1091 # Resolved by the installed ~/.local/bin symlink.
source "\$HOME/.local/bin/load-api-keys.sh" || exit \$?
exec $launch_command "\$@"$launch_flags
EOF

chmod +x "$launcher_file"
print_success "Launcher script created and made executable."

# Create or update aliases file
print_info "Adding alias to: $aliases_file"
if [[ ! -f "$aliases_file" ]]; then
  touch "$aliases_file"
  print_info "Created new aliases file."
fi

# Check if alias already exists
if grep -q "alias ${program}-${category}=" "$aliases_file"; then
  print_warning "Alias ${program}-${category} already exists in aliases file."
else
  # Ensure the file ends with a newline before appending
  if [[ -f "$aliases_file" ]] && [[ -s "$aliases_file" ]] && [[ "$(tail -c1 "$aliases_file")" != $'\n' ]]; then
    echo >> "$aliases_file"
  fi
  echo "alias ${program}-${category}=\"\$HOME/.local/bin/${program}-launcher\"" >> "$aliases_file"
  print_success "Alias added to aliases file."
fi

# Ensure shell config sources the aliases file
print_info "Checking if $SHELL_TYPE config sources the aliases file..."
if ! grep -q "$source_pattern" "$shell_rc_file"; then
    print_info "Adding source line to $SHELL_TYPE config..."
    # Find a good place to add it, perhaps after the existing aliases
    # For now, add it at the end
    echo "" >>"$shell_rc_file"
    echo "# Source custom aliases" >>"$shell_rc_file"
    if [[ "$SHELL_TYPE" == "bash" ]]; then
        printf 'source "%s/bash/.config/bash/aliases.sh"\n' "$DOTFILES_DIR" >>"$shell_rc_file"
    else
        printf 'source "%s/zsh/.config/zsh/aliases.zsh"\n' "$DOTFILES_DIR" >>"$shell_rc_file"
    fi
    print_success "Source line added to $SHELL_TYPE config."
else
    print_info "$SHELL_TYPE config already sources the aliases file."
fi

print_success "App launcher setup complete!"
print_info "You can now use the alias '${program}-${category}' to launch $program with API keys loaded."
print_info "Run 'stow $SHELL_TYPE' to symlink the updated config if needed."
