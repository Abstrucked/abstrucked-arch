#!/bin/sh

set -eu

# Screenshot for the 3440x1440 output in either X11 or Hyprland.

timestamp="$(date +%Y%m%d%H%M%S)"
targetbase="$HOME/screenshots"
mkdir -p "$targetbase"
[ -d "$targetbase" ] || exit 1

if [ "${XDG_SESSION_TYPE:-}" = wayland ] || [ -n "${WAYLAND_DISPLAY:-}" ]; then
    if ! command -v grim >/dev/null 2>&1; then
        printf '%s\n' 'grim is required for Wayland screenshots' >&2
        exit 1
    fi

    geometry="$(
        hyprctl monitors -j 2>/dev/null |
            jq -r 'first(.[] | select(.width == 3440 and .height == 1440) | "\(.x),\(.y) \(.width)x\(.height)") // empty' 2>/dev/null || true
    )"
    if [ -n "$geometry" ]; then
        grim -g "$geometry" "$targetbase/$timestamp.png"
    else
        grim "$targetbase/$timestamp.png"
    fi
    exit 0
fi

if ! command -v scrot >/dev/null 2>&1; then
    printf '%s\n' 'scrot is required for X11 screenshots' >&2
    exit 1
fi
scrot -a "0,0,3440,1440" "$targetbase/$timestamp.png"
