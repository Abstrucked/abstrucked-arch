#!/bin/bash
# tmux-agent -- agent awareness for tmux. Detects coding agents running in
# panes (opencode, claude, codex, ...) and tracks their state:
#   blocked (red)    -- needs input or approval
#   working (yellow) -- actively running
#   ready (blue)     -- finished, the pane has not been looked at since
#   idle (green)     -- finished and seen
#
# Subcommands:
#   strip                glyph strip for status-right
#   window-dot <win_id>  rollup state dot for a window status entry
#   pane-label <pane_id> agent + state label for pane-border-format
#   seen <pane_id>       mark the pane's state as seen (pane-focus-in hook)
#   status [--json]      list agent panes and states
#   pick                 fuzzy finder over agent panes (prefix + A)
#   read --pane <id> [--lines N] [--ansi]   pane snapshot for fzf previews
#   wait --pane <id> --state <state> [--timeout SEC]
#   report --pane <id> --state <state>      hook-reported state override
#   attach --next        jump to the most urgent agent pane
#   refresh              update cached state now
#
# State is cached in $TMUX_AGENT_STATE_DIR (default /tmp/tmux-agent-$UID).
# tmux's status interval drives refreshes; set TMUX_AGENT_QUIET=1 to skip
# desktop notifications.
set -euo pipefail

SELF="$(readlink -f "$0")"
# shellcheck source=../lib/tmux-agent/engine.sh
. "$(dirname "$SELF")/../lib/tmux-agent/engine.sh"

declare -r TA_STATE_DIR="${TMUX_AGENT_STATE_DIR:-${TMPDIR:-/tmp}/tmux-agent-$(id -u)}"
declare -r TA_PANE_FMT='#{pane_id}|#{pane_pid}|#{window_id}|#{session_name}:#{window_index}.#{pane_index}|#{pane_current_path}'
declare -r TA_REPORT_TTL=300

now() { date +%s; }

age_str() {
    local s=$1
    if ((s < 3600)); then
        echo "$((s / 60))m"
    elif ((s < 86400)); then
        echo "$((s / 3600))h"
    else
        echo "$((s / 86400))d"
    fi
}

tail_lines() {
    # Last $1 non-empty lines of stdin.
    grep -v '^[[:space:]]*$' | tail -n "${1:-12}" || true
}

mark_seen() {
    mkdir -p "$TA_STATE_DIR"
    now >"$TA_STATE_DIR/seen-$1"
}

refresh() {
    # Scan every pane once per TA_STATE_DIR/stamp interval (3s) unless forced.
    local force=${1:-0} now_s stamp
    mkdir -p "$TA_STATE_DIR"
    now_s=$(now)
    stamp="$TA_STATE_DIR/stamp"
    if [[ $force != 1 && -f $stamp ]]; then
        ((now_s - $(cat "$stamp") >= 3)) || return 0
    fi
    printf '%s\n' "$now_s" >"$stamp"

    local pane pid wid target path detect agent apid cpu tail
    local state prev prev_cpu changed seen rstate repoch f base
    local -A live=()
    while IFS='|' read -r pane pid wid target path; do
        [[ -n $pane ]] || continue
        live[$pane]=1
        detect=$(ta_detect_agent "$pid" || true)
        if [[ -z $detect && ! -f $TA_STATE_DIR/report-$pane ]]; then
            rm -f "$TA_STATE_DIR/state-$pane" "$TA_STATE_DIR/seen-$pane"
            continue
        fi
        agent=custom apid='' cpu=0
        if [[ -n $detect ]]; then
            read -r agent apid <<<"$detect"
            cpu=$(ta_proc_cpu "$apid" || echo 0)
        fi
        tail=$(tmux capture-pane -p -J -S -30 -t "$pane" 2>/dev/null | tail_lines 12 || true)

        prev='' prev_cpu=0 changed=$now_s
        if [[ -f $TA_STATE_DIR/state-$pane ]]; then
            IFS='|' read -r prev _ag prev_cpu changed _up _tgt _wid _path \
                <"$TA_STATE_DIR/state-$pane" || true
            [[ $prev_cpu =~ ^[0-9]+$ ]] || prev_cpu=0
            [[ $changed =~ ^[0-9]+$ ]] || changed=$now_s
        fi
        seen=0
        if [[ -f $TA_STATE_DIR/seen-$pane ]]; then
            (($(cat "$TA_STATE_DIR/seen-$pane") >= changed)) && seen=1
        fi

        state=$(ta_classify "$tail" "$((cpu - prev_cpu))" "$prev" "$seen")
        # A hook-reported state wins until it goes stale.
        rstate='' repoch=0
        if [[ -f $TA_STATE_DIR/report-$pane ]]; then
            IFS='|' read -r rstate repoch <"$TA_STATE_DIR/report-$pane" || true
            [[ $repoch =~ ^[0-9]+$ ]] || repoch=0
            if [[ -n $rstate ]] && ((now_s - repoch < TA_REPORT_TTL)); then
                state=$rstate
            else
                rm -f "$TA_STATE_DIR/report-$pane"
            fi
        fi

        [[ $state == "$prev" ]] || changed=$now_s
        printf '%s|%s|%s|%s|%s|%s|%s|%s\n' \
            "$state" "$agent" "$cpu" "$changed" "$now_s" "$target" "$wid" "$path" \
            >"$TA_STATE_DIR/state-$pane"

        # Notify only on real transitions of background panes.
        if [[ -z ${TMUX_AGENT_QUIET:-} && -n $prev && $state != "$prev" ]] &&
            { [[ $state == blocked ]] || [[ $state == ready ]]; }; then
            if [[ $pane != "$(tmux display-message -p '#{pane_id}' 2>/dev/null || true)" ]] &&
                command -v notify-send >/dev/null 2>&1; then
                notify-send -a tmux-agent "$agent on $target" "is $state" 2>/dev/null || true
            fi
        fi
    done < <(tmux list-panes -a -F "$TA_PANE_FMT" 2>/dev/null || true)

    for f in "$TA_STATE_DIR"/state-* "$TA_STATE_DIR"/seen-* "$TA_STATE_DIR"/report-*; do
        [[ -e $f ]] || continue
        base=${f##*-}
        [[ -n ${live[$base]:-} ]] || rm -f "$f"
    done
}

strip() {
    refresh
    local f st ag s out=''
    for s in blocked working ready idle; do
        for f in "$TA_STATE_DIR"/state-*; do
            [[ -e $f ]] || continue
            IFS='|' read -r st ag _rest <"$f" || continue
            [[ $st == "$s" ]] || continue
            out="$out #[fg=$(ta_state_color "$st")]$(ta_agent_glyph "$ag")#[default]"
        done
    done
    printf '%s' "$out"
}

window_dot() {
    local wid=$1 f st w worst=''
    refresh
    for f in "$TA_STATE_DIR"/state-*; do
        [[ -e $f ]] || continue
        IFS='|' read -r st _ag _cpu _ch _up _tgt w _path <"$f" || continue
        [[ $w == "$wid" ]] || continue
        worst=$(ta_rollup "$worst" "$st")
    done
    if [[ -n $worst ]]; then
        printf '#[fg=%s]●' "$(ta_state_color "$worst")"
    fi
}

pane_label() {
    local pane=$1 f st ag
    refresh
    f="$TA_STATE_DIR/state-$pane"
    if [[ ! -f $f ]]; then
        tmux display-message -p -t "$pane" '#{pane_index} #{pane_title}' 2>/dev/null || printf 'shell'
        return 0
    fi
    IFS='|' read -r st ag _rest <"$f"
    printf ' #[fg=%s]%s %s · %s ' "$(ta_state_color "$st")" "$(ta_agent_glyph "$ag")" "$ag" "$st"
}

cmd_status() {
    local json=0
    [[ ${1:-} == --json ]] && json=1
    refresh
    local f st ag cpu ch up tgt wid path pane age s
    for s in blocked working ready idle; do
        for f in "$TA_STATE_DIR"/state-*; do
            [[ -e $f ]] || continue
            pane=${f##*-}
            IFS='|' read -r st ag cpu ch up tgt wid path <"$f" || continue
            [[ $st == "$s" ]] || continue
            age=$((up - ch))
            if ((json)); then
                jq -cn --arg pane "$pane" --arg state "$st" --arg agent "$ag" \
                    --arg target "$tgt" --arg window "$wid" --arg path "$path" \
                    --argjson age "$age" \
                    '{pane:$pane,state:$state,agent:$agent,target:$target,window:$window,path:$path,age:$age}'
            else
                printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
                    "$(ta_state_ansi "$st")$(ta_agent_glyph "$ag")" \
                    "$ag" "${path##*/}" "$tgt" "$(age_str "$age")" "$pane"
            fi
        done
    done
}

cmd_read() {
    local pane='' lines=20 ansi=0
    while (($#)); do
        case $1 in
        --pane)
            pane=$2
            shift 2
            ;;
        --lines)
            lines=$2
            shift 2
            ;;
        --ansi)
            ansi=1
            shift
            ;;
        *) shift ;;
        esac
    done
    local -a opts=(-p -J -S "-$((lines * 2))" -t "$pane")
    ((ansi)) && opts+=(-e)
    tmux capture-pane "${opts[@]}" 2>/dev/null | tail_lines "$lines" || true
}

cmd_wait() {
    local pane='' want='' timeout=0 waited=0 st
    while (($#)); do
        case $1 in
        --pane)
            pane=$2
            shift 2
            ;;
        --state)
            want=$2
            shift 2
            ;;
        --timeout)
            timeout=$2
            shift 2
            ;;
        *) shift ;;
        esac
    done
    while :; do
        refresh
        st=''
        [[ -f $TA_STATE_DIR/state-$pane ]] &&
            IFS='|' read -r st _rest <"$TA_STATE_DIR/state-$pane" || true
        [[ $st == "$want" ]] && return 0
        if ((timeout > 0 && waited >= timeout)); then
            return 1
        fi
        sleep 1
        waited=$((waited + 1))
    done
}

cmd_report() {
    local pane='' want=''
    while (($#)); do
        case $1 in
        --pane)
            pane=$2
            shift 2
            ;;
        --state)
            want=$2
            shift 2
            ;;
        *) shift ;;
        esac
    done
    [[ -n $pane && -n $want ]] || return 1
    mkdir -p "$TA_STATE_DIR"
    printf '%s|%s\n' "$want" "$(now)" >"$TA_STATE_DIR/report-$pane"
}

goto_pane() {
    local pane=$1 wid
    wid=$(tmux display-message -p -t "$pane" '#{window_id}')
    tmux select-window -t "$wid"
    tmux select-pane -t "$pane"
    mark_seen "$pane"
}

cmd_attach() {
    refresh
    local f st pane s
    for s in blocked working ready idle; do
        for f in "$TA_STATE_DIR"/state-*; do
            [[ -e $f ]] || continue
            pane=${f##*-}
            IFS='|' read -r st _rest <"$f" || continue
            [[ $st == "$s" ]] || continue
            goto_pane "$pane"
            return 0
        done
    done
    echo "no agent panes" >&2
    return 1
}

cmd_pick() {
    refresh
    local rows=() f st ag cpu ch up tgt wid path pane age s
    for s in blocked working ready idle; do
        for f in "$TA_STATE_DIR"/state-*; do
            [[ -e $f ]] || continue
            pane=${f##*-}
            IFS='|' read -r st ag cpu ch up tgt wid path <"$f" || continue
            [[ $st == "$s" ]] || continue
            age=$(($(now) - ch))
            rows+=("$(ta_state_ansi "$st")$(ta_agent_glyph "$ag")"$'\t'"$ag"$'\t'"${path##*/}"$'\t'"$tgt"$'\t'"$(age_str "$age")"$'\t'"$pane")
        done
    done
    if ((${#rows[@]} == 0)); then
        echo "no agent panes" >&2
        return 1
    fi
    local sel
    sel=$(printf '%s\n' "${rows[@]}" | fzf --ansi --reverse \
        --delimiter=$'\t' --with-nth=1,2,3,4,5 \
        --preview "$SELF read --pane {6} --lines 20 --ansi" \
        --preview-window 'right,60%,border-left') || return 0
    goto_pane "${sel##*$'\t'}"
}

usage() {
    sed -n '2,25p' "$SELF" | sed 's/^# \{0,1\}//'
}

main() {
    local cmd=${1:-}
    shift || true
    case $cmd in
    refresh) refresh "${1:-0}" ;;
    strip) strip ;;
    window-dot) window_dot "${1:-}" ;;
    pane-label) pane_label "${1:-}" ;;
    seen) mark_seen "${1:-}" ;;
    status) cmd_status "$@" ;;
    pick) cmd_pick ;;
    read) cmd_read "$@" ;;
    wait) cmd_wait "$@" ;;
    report) cmd_report "$@" ;;
    attach) cmd_attach "$@" ;;
    *)
        usage
        exit 1
        ;;
    esac
}

main "$@"
