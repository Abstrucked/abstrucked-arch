#!/bin/bash
# tmux-agent -- agent awareness for tmux. Detects coding agents running in
# panes (opencode, claude, codex, ...) and tracks their state:
#   blocked (red)    -- needs input or approval
#   working (yellow) -- actively running
#   ready (blue)     -- finished, the pane has not been looked at since
#   idle (green)     -- finished and seen
#
# Subcommands:
#   strip                glyph strip for the status bar
#   window-dot <win_id>  rollup state dot for a window status entry
#   pane-label <pane_id> agent + state label for pane-border-format
#   seen <pane_id>       mark the pane's state as seen (pane-focus-in hook)
#   status [--json]      list agent panes and states
#   pick                 fuzzy finder over agent panes (prefix + A)
#   read --pane <id> [--lines N] [--ansi]   pane snapshot for fzf previews
#   wait --pane <id> --state <state> [--timeout SEC]
#   report --pane <id> --state <state>      hook-reported state override
#   hook <agent> <event> agent lifecycle hook (Claude Code, Codex, OpenCode)
#   install-hooks [claude|codex|opencode ...]  wire the agents' hooks up
#   place-strip          centre the strip in the status bar (tmux.conf)
#   attach --next        jump to the most urgent agent pane
#   refresh              update cached state now
#
# State is cached in $TMUX_AGENT_STATE_DIR (default /tmp/tmux-agent-$UID).
# tmux's status interval drives refreshes; set TMUX_AGENT_QUIET=1 to skip
# desktop notifications.
set -euo pipefail

SELF="$(readlink -f "$0")"
# shellcheck source=../lib/tmux-agent/engine.sh
. "$(dirname "$SELF")/../lib/tmux-agent/engine.sh"

declare -r TA_STATE_DIR="${TMUX_AGENT_STATE_DIR:-${TMPDIR:-/tmp}/tmux-agent-$(id -u)}"
declare -r TA_PANE_FMT='#{pane_id}|#{pane_pid}|#{window_id}|#{session_name}:#{window_index}.#{pane_index}|#{pane_current_path}'
declare -r TA_REPORT_TTL=300

now() { date +%s; }

age_str() {
    local s=$1
    if ((s < 3600)); then
        echo "$((s / 60))m"
    elif ((s < 86400)); then
        echo "$((s / 3600))h"
    else
        echo "$((s / 86400))d"
    fi
}

tail_lines() {
    # Last $1 non-empty lines of stdin.
    grep -v '^[[:space:]]*$' | tail -n "${1:-12}" || true
}

pane_in_view() {
    # True when a focused client shows $1: its window is the session's
    # current one and it is that window's active pane.
    local name
    while read -r name; do
        [[ -n $name ]] || continue
        [[ $(tmux display-message -p -c "$name" '#{pane_id}' 2>/dev/null) == "$1" ]] && return 0
    done < <(tmux list-clients -F '#{?#{m:*focused*,#{client_flags}},#{client_name},}' 2>/dev/null)
    return 1
}

notify() {
    # $1 agent, $2 state, $3 tmux target, $4 working directory.
    command -v notify-send >/dev/null 2>&1 || return 0
    local what=finished urgency=normal
    if [[ $2 == blocked ]]; then
        what='needs input'
        urgency=critical
    fi
    notify-send -a tmux-agent -u "$urgency" "$1 $what" "${4##*/} · $3" 2>/dev/null || true
}

mark_seen() {
    mkdir -p "$TA_STATE_DIR"
    now >"$TA_STATE_DIR/seen-$1"
}

refresh() {
    # Hooks refresh in the background while the status bar polls. Serialize
    # scans so a transition is seen, and notified, exactly once.
    local lock_fd rc=0
    mkdir -p "$TA_STATE_DIR"
    exec {lock_fd}>"$TA_STATE_DIR/lock"
    flock "$lock_fd"
    scan "$@" || rc=$?
    exec {lock_fd}>&-
    return "$rc"
}

scan() {
    # Scan every pane once per TA_STATE_DIR/stamp interval (3s) unless forced.
    local force=${1:-0} now_s stamp
    now_s=$(now)
    stamp="$TA_STATE_DIR/stamp"
    if [[ $force != 1 && -f $stamp ]]; then
        ((now_s - $(cat "$stamp") >= 3)) || return 0
    fi
    printf '%s\n' "$now_s" >"$stamp"

    local pane pid wid target path detect agent apid cpu tail tail_hash
    local state prev prev_cpu prev_tail_hash changed seen output_changed rstate repoch f base
    local -A live=()
    while IFS='|' read -r pane pid wid target path; do
        [[ -n $pane ]] || continue
        live[$pane]=1
        detect=$(ta_detect_agent "$pid" || true)
        if [[ -z $detect && ! -f $TA_STATE_DIR/report-$pane ]]; then
            rm -f "$TA_STATE_DIR/state-$pane" "$TA_STATE_DIR/seen-$pane"
            continue
        fi
        agent=custom apid='' cpu=0
        if [[ -n $detect ]]; then
            read -r agent apid <<<"$detect"
            cpu=$(ta_proc_cpu "$apid" || echo 0)
        fi
        tail=$(tmux capture-pane -p -J -S -30 -t "$pane" 2>/dev/null | tail_lines 12 || true)
        read -r tail_hash _ <<<"$(cksum <<<"$tail")"

        prev='' prev_cpu=0 prev_tail_hash='' changed=$now_s
        if [[ -f $TA_STATE_DIR/state-$pane ]]; then
            IFS='|' read -r prev _ag prev_cpu changed _up _tgt _wid _path prev_tail_hash \
                <"$TA_STATE_DIR/state-$pane" || true
            [[ $prev_cpu =~ ^[0-9]+$ ]] || prev_cpu=0
            [[ $changed =~ ^[0-9]+$ ]] || changed=$now_s
        fi
        output_changed=0
        if [[ -n $prev_tail_hash && $tail_hash != "$prev_tail_hash" ]]; then
            output_changed=1
        fi
        seen=0
        if [[ -f $TA_STATE_DIR/seen-$pane ]]; then
            (($(cat "$TA_STATE_DIR/seen-$pane") >= changed)) && seen=1
        fi

        state=$(ta_classify "$tail" "$((cpu - prev_cpu))" "$prev" "$seen" "$output_changed")
        # A hook-reported state wins over the heuristics. Agent hooks report
        # every transition, so their settled states hold while the agent
        # lives. "working" and reports without a detected agent expire:
        # an interrupted turn fires no Stop hook.
        rstate='' repoch=0
        if [[ -f $TA_STATE_DIR/report-$pane ]]; then
            IFS='|' read -r rstate repoch <"$TA_STATE_DIR/report-$pane" || true
            [[ $repoch =~ ^[0-9]+$ ]] || repoch=0
            if [[ -n $rstate ]] && { ((now_s - repoch < TA_REPORT_TTL)) ||
                { [[ -n $detect && $rstate != working ]]; }; }; then
                state=$rstate
                # Seen after the agent reported it finished: acknowledged.
                if [[ $state == ready && -f $TA_STATE_DIR/seen-$pane ]] &&
                    (($(cat "$TA_STATE_DIR/seen-$pane") >= repoch)); then
                    state=idle
                fi
            else
                rm -f "$TA_STATE_DIR/report-$pane"
            fi
        fi

        [[ $state == "$prev" ]] || changed=$now_s
        printf '%s|%s|%s|%s|%s|%s|%s|%s|%s\n' \
            "$state" "$agent" "$cpu" "$changed" "$now_s" "$target" "$wid" "$path" "$tail_hash" \
            >"$TA_STATE_DIR/state-$pane"

        # Notify on real transitions of panes nobody is looking at.
        if [[ -z ${TMUX_AGENT_QUIET:-} && -n $prev && $state != "$prev" ]] &&
            { [[ $state == blocked ]] || [[ $state == ready ]]; } &&
            ! pane_in_view "$pane"; then
            notify "$agent" "$state" "$target" "$path"
        fi
    done < <(tmux list-panes -a -F "$TA_PANE_FMT" 2>/dev/null || true)

    for f in "$TA_STATE_DIR"/state-* "$TA_STATE_DIR"/seen-* "$TA_STATE_DIR"/report-*; do
        [[ -e $f ]] || continue
        base=${f##*-}
        [[ -n ${live[$base]:-} ]] || rm -f "$f"
    done
}

strip() {
    refresh
    local f st ag s out=''
    for s in blocked working ready idle; do
        for f in "$TA_STATE_DIR"/state-*; do
            [[ -e $f ]] || continue
            IFS='|' read -r st ag _rest <"$f" || continue
            [[ $st == "$s" ]] || continue
            out="$out #[fg=$(ta_state_color "$st")]$(ta_agent_glyph "$ag")#[default]"
        done
    done
    printf '%s' "$out"
}

window_dot() {
    local wid=$1 f st w worst=''
    refresh
    for f in "$TA_STATE_DIR"/state-*; do
        [[ -e $f ]] || continue
        IFS='|' read -r st _ag _cpu _ch _up _tgt w _path <"$f" || continue
        [[ $w == "$wid" ]] || continue
        worst=$(ta_rollup "$worst" "$st")
    done
    if [[ -n $worst ]]; then
        printf '#[fg=%s]●' "$(ta_state_color "$worst")"
    fi
}

pane_label() {
    local pane=$1 f st ag
    refresh
    f="$TA_STATE_DIR/state-$pane"
    if [[ ! -f $f ]]; then
        tmux display-message -p -t "$pane" '#{pane_index} #{pane_title}' 2>/dev/null || printf 'shell'
        return 0
    fi
    IFS='|' read -r st ag _rest <"$f"
    printf ' #[fg=%s]%s %s · %s ' "$(ta_state_color "$st")" "$(ta_agent_glyph "$ag")" "$ag" "$st"
}

cmd_status() {
    local json=0
    [[ ${1:-} == --json ]] && json=1
    refresh
    local f st ag cpu ch up tgt wid path pane age s
    for s in blocked working ready idle; do
        for f in "$TA_STATE_DIR"/state-*; do
            [[ -e $f ]] || continue
            pane=${f##*-}
            IFS='|' read -r st ag cpu ch up tgt wid path _hash <"$f" || continue
            [[ $st == "$s" ]] || continue
            age=$((up - ch))
            if ((json)); then
                jq -cn --arg pane "$pane" --arg state "$st" --arg agent "$ag" \
                    --arg target "$tgt" --arg window "$wid" --arg path "$path" \
                    --argjson age "$age" \
                    '{pane:$pane,state:$state,agent:$agent,target:$target,window:$window,path:$path,age:$age}'
            else
                printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
                    "$(ta_state_ansi "$st")$(ta_agent_glyph "$ag")" \
                    "$ag" "${path##*/}" "$tgt" "$(age_str "$age")" "$pane"
            fi
        done
    done
}

cmd_read() {
    local pane='' lines=20 ansi=0
    while (($#)); do
        case $1 in
        --pane)
            pane=$2
            shift 2
            ;;
        --lines)
            lines=$2
            shift 2
            ;;
        --ansi)
            ansi=1
            shift
            ;;
        *) shift ;;
        esac
    done
    local -a opts=(-p -J -S "-$((lines * 2))" -t "$pane")
    ((ansi)) && opts+=(-e)
    tmux capture-pane "${opts[@]}" 2>/dev/null | tail_lines "$lines" || true
}

cmd_wait() {
    local pane='' want='' timeout=0 waited=0 st
    while (($#)); do
        case $1 in
        --pane)
            pane=$2
            shift 2
            ;;
        --state)
            want=$2
            shift 2
            ;;
        --timeout)
            timeout=$2
            shift 2
            ;;
        *) shift ;;
        esac
    done
    while :; do
        refresh
        st=''
        [[ -f $TA_STATE_DIR/state-$pane ]] &&
            IFS='|' read -r st _rest <"$TA_STATE_DIR/state-$pane" || true
        [[ $st == "$want" ]] && return 0
        if ((timeout > 0 && waited >= timeout)); then
            return 1
        fi
        sleep 1
        waited=$((waited + 1))
    done
}

cmd_report() {
    local pane='' want=''
    while (($#)); do
        case $1 in
        --pane)
            pane=$2
            shift 2
            ;;
        --state)
            want=$2
            shift 2
            ;;
        *) shift ;;
        esac
    done
    [[ -n $pane && -n $want ]] || return 1
    mkdir -p "$TA_STATE_DIR"
    printf '%s|%s\n' "$want" "$(now)" >"$TA_STATE_DIR/report-$pane"
}

cmd_hook() {
    # Agent lifecycle hook: tmux-agent hook <agent> <event>. Runs inside the
    # agent, so it never fails, never writes to stdout (Claude Code feeds
    # hook stdout back to the model) and never waits on the pane scan.
    local event=${2:-} pane=${TMUX_PANE:-} state prev='' report
    # Claude Code and Codex pipe a JSON payload; drain it unread.
    [[ -t 0 ]] || cat >/dev/null 2>&1 || true
    [[ -n $pane ]] || return 0
    state=$(ta_hook_state "$event")
    [[ -n $state ]] || return 0
    mkdir -p "$TA_STATE_DIR"
    report="$TA_STATE_DIR/report-$pane"
    if [[ $state == end ]]; then
        rm -f "$report"
    else
        [[ -f $report ]] && IFS='|' read -r prev _ <"$report"
        printf '%s|%s\n' "$state" "$(now)" >"$report"
        # Tool hooks fire constantly; only a new state needs a rescan.
        [[ $state != "$prev" ]] || return 0
    fi
    (
        refresh 1
        tmux list-clients -F '#{client_name}' | while read -r c; do
            tmux refresh-client -S -t "$c"
        done
    ) </dev/null >/dev/null 2>&1 &
    return 0
}

cmd_place_strip() {
    # Centre the agent strip in the status bar: insert it into
    # status-format[0] just before the status-right section. Formats
    # without that section get the strip appended to status-right.
    local strip='#(~/.local/bin/tmux-agent strip)' fmt marker='#[nolist align=right'
    fmt=$(tmux show -gv 'status-format[0]' 2>/dev/null) || return 0
    [[ $fmt == *"tmux-agent strip"* ]] && return 0
    if [[ $fmt == *"$marker"* ]]; then
        tmux set -g 'status-format[0]' \
            "${fmt/"$marker"/"#[nolist align=absolute-centre]$strip$marker"}"
    elif [[ $(tmux show -gv status-right) != *"tmux-agent strip"* ]]; then
        tmux set -ag status-right " $strip"
    fi
}

goto_pane() {
    local pane=$1 wid
    wid=$(tmux display-message -p -t "$pane" '#{window_id}')
    tmux select-window -t "$wid"
    tmux select-pane -t "$pane"
    mark_seen "$pane"
}

cmd_attach() {
    refresh
    local f st pane s
    for s in blocked working ready idle; do
        for f in "$TA_STATE_DIR"/state-*; do
            [[ -e $f ]] || continue
            pane=${f##*-}
            IFS='|' read -r st _rest <"$f" || continue
            [[ $st == "$s" ]] || continue
            goto_pane "$pane"
            return 0
        done
    done
    echo "no agent panes" >&2
    return 1
}

pad() {
    # $1 text, $2 width: left-aligned, padded with spaces. Counts characters,
    # not bytes, so it lines up where printf's %-Ns would not.
    printf '%s%*s' "$1" "$(($2 > ${#1} ? $2 - ${#1} : 0))" ''
}

cmd_pick() {
    refresh
    local f st ag cpu ch up tgt wid path pane s i
    local -a sts=() ags=() dirs=() tgts=() ages=() panes=()
    for s in blocked working ready idle; do
        for f in "$TA_STATE_DIR"/state-*; do
            [[ -e $f ]] || continue
            pane=${f##*-}
            IFS='|' read -r st ag cpu ch up tgt wid path _hash <"$f" || continue
            [[ $st == "$s" ]] || continue
            sts+=("$st") ags+=("$ag") dirs+=("${path##*/}") tgts+=("$tgt") panes+=("$pane")
            ages+=("$(age_str "$(($(now) - ch))")")
        done
    done
    if ((${#panes[@]} == 0)); then
        echo "no agent panes" >&2
        return 1
    fi
    # Pad columns to their widest entry. Tabs would jump to the next 8-column
    # stop whenever a name is 8 characters long ("opencode").
    local wa=0 wd=0 wt=0
    for i in "${!panes[@]}"; do
        ((${#ags[i]} > wa)) && wa=${#ags[i]}
        ((${#dirs[i]} > wd)) && wd=${#dirs[i]}
        ((${#tgts[i]} > wt)) && wt=${#tgts[i]}
    done
    local rows=()
    for i in "${!panes[@]}"; do
        # The pane id rides along after a tab, hidden from the list.
        rows+=("$(ta_state_ansi "${sts[i]}")$(ta_agent_glyph "${ags[i]}")  $(pad "${ags[i]}" "$wa")  $(pad "${dirs[i]}" "$wd")  $(pad "${tgts[i]}" "$wt")  ${ages[i]}"$'\t'"${panes[i]}")
    done
    local sel
    sel=$(printf '%s\n' "${rows[@]}" | fzf --ansi --reverse \
        --delimiter=$'\t' --with-nth=1 \
        --preview "$SELF read --pane {2} --lines 20 --ansi" \
        --preview-window 'right,60%,border-left') || return 0
    goto_pane "${sel##*$'\t'}"
}

usage() {
    sed -n '2,27p' "$SELF" | sed 's/^# \{0,1\}//'
}

main() {
    local cmd=${1:-}
    shift || true
    case $cmd in
    refresh) refresh "${1:-0}" ;;
    strip) strip ;;
    window-dot) window_dot "${1:-}" ;;
    pane-label) pane_label "${1:-}" ;;
    seen) mark_seen "${1:-}" ;;
    status) cmd_status "$@" ;;
    pick) cmd_pick ;;
    read) cmd_read "$@" ;;
    wait) cmd_wait "$@" ;;
    report) cmd_report "$@" ;;
    hook) cmd_hook "$@" || true ;;
    place-strip) cmd_place_strip ;;
    install-hooks) "$(dirname "$SELF")/../lib/tmux-agent/install-hooks" "$@" ;;
    attach) cmd_attach "$@" ;;
    *)
        usage
        exit 1
        ;;
    esac
}

main "$@"
