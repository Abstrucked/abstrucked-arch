#!/usr/bin/env bash
# Tmux sessionizer - quickly switch between project directories

set -euo pipefail

# Check dependencies
if ! command -v tmux &>/dev/null; then
  echo "Error: tmux is not installed" >&2
  exit 1
fi

# Handle popup mode
if [[ "${1:-}" == "--popup" ]]; then
  # If already in a popup, just run normally
  if [[ -n "${TMUX_PAD:-}" ]]; then
    shift
  else
    # Open in popup and exit
    tmux display-popup -E -w 80% -h 80% -d "$(pwd)" "$0"
    exit 0
  fi
fi

# Find project directories
find_dirs() {
  local dirs=()
  
  # Add common directories if they exist
  [[ -d "$HOME" ]] && dirs+=("$HOME")
  local config_dir=${DOTFILES_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}}
  local dev_dir=${DOTFILES_DEV_DIR:-$HOME/_dev}
  [[ -d "$config_dir" ]] && dirs+=("$config_dir")
  [[ -d "$dev_dir" ]] && dirs+=("$dev_dir")
  [[ -d "$HOME/Projects" ]] && dirs+=("$HOME/Projects")
  
  # Add current directory
  dirs+=("$(pwd)")
  
  # Find all directories (sorted, unique)
  for dir in "${dirs[@]}"; do
    find -L "$dir" -mindepth 1 -maxdepth 1 -type d 2>/dev/null || return
  done | sort -u
}

# Get selection
if [[ $# -eq 1 ]]; then
  selected="$1"
else
  if ! command -v fzf &>/dev/null; then
    echo "Error: fzf is not installed" >&2
    echo "Install with: sudo pacman -S fzf" >&2
    exit 1
  fi
  # Resolve discovery separately so clean fzf cancellation cannot mask find failures.
  if found_dirs=$(find_dirs); then
    :
  else
    discovery_status=$?
    echo "Error: could not discover project directories" >&2
    exit "$discovery_status"
  fi
  if [[ -n "$found_dirs" ]]; then
    if selected=$(fzf --prompt="Select project> " --height=40% --reverse <<<"$found_dirs"); then
      fzf_status=0
    else
      fzf_status=$?
    fi
  else
    if selected=$(fzf --prompt="Select project> " --height=40% --reverse </dev/null); then
      fzf_status=0
    else
      fzf_status=$?
    fi
  fi
  if [[ $fzf_status -eq 1 ]]; then
    exit 0
  elif [[ $fzf_status -ne 0 ]]; then
    exit "$fzf_status"
  fi
fi

if [[ -z "$selected" ]]; then
  exit 0
fi

if [[ ! -d "$selected" ]]; then
  echo "Error: project directory does not exist: $selected" >&2
  exit 1
fi

# Create session name (replace dots with underscores for tmux compatibility)
selected_name=$(basename "$selected" | tr . _)

# Create session if it doesn't exist
if ! tmux has-session -t="$selected_name" 2>/dev/null; then
  tmux new-session -ds "$selected_name" -c "$selected"
fi

# An existing server is not the same as an attached client. Outside tmux,
# attach to the requested session rather than trying to switch no client.
if [[ -n "${TMUX:-}" ]]; then
  tmux switch-client -t "$selected_name"
else
  tmux attach-session -t "$selected_name"
fi
