#!/bin/bash
# Enable the power-mode widget to switch CPU power profiles without a password prompt.

set -euo pipefail

readonly SUDOERS_FILE="/etc/sudoers.d/ryzenadj"
# Kept off PATH: a wrapper in /usr/local/bin would shadow the real ryzenadj for
# every user and could clobber a locally installed build.
readonly WRAPPER_FILE="/usr/local/lib/ryzenadj-power-profile"
USERNAME=$(whoami)
readonly USERNAME

if [[ -z "$USERNAME" || ! "$USERNAME" =~ ^[a-zA-Z0-9_-]+$ ]]; then
    printf '%s\n' 'Error: username is empty or contains sudoers-special characters' >&2
    exit 1
fi

if ! command -v ryzenadj >/dev/null 2>&1; then
    printf '%s\n' 'Error: ryzenadj is not installed' >&2
    printf '%s\n' 'Install with: sudo pacman -S ryzenadj' >&2
    exit 1
fi

wrapper_tmp=$(mktemp)
candidate_tmp=''
cleanup() {
    rm -f -- "$wrapper_tmp"
    if [[ -n "$candidate_tmp" ]]; then
        rm -f -- "$candidate_tmp"
    fi
}
trap cleanup EXIT

cat >"$wrapper_tmp" <<'WRAPPER'
#!/bin/bash
set -euo pipefail

if [[ "$#" -ne 4 ]]; then
    printf '%s\n' 'ryzenadj: expected four power-profile limits' >&2
    exit 2
fi

for index in 1 2 3 4; do
    case "$index" in
        1) prefix='--stapm-limit=' ;;
        2) prefix='--fast-limit=' ;;
        3) prefix='--slow-limit=' ;;
        4) prefix='--tctl-temp=' ;;
    esac
    argument=${!index}
    value=${argument#"$prefix"}
    if [[ "$argument" != "$prefix"* || ! "$value" =~ ^[1-9][0-9]{0,8}$ ]]; then
        printf '%s\n' 'ryzenadj: invalid power-profile limit' >&2
        exit 2
    fi
done

exec /usr/bin/ryzenadj "$@"
WRAPPER

printf '%s\n' 'Installing restricted ryzenadj wrapper...'
sudo install -m 0755 -o root -g root "$wrapper_tmp" "$WRAPPER_FILE"

candidate_tmp=$(mktemp)
printf '%s ALL=(ALL) NOPASSWD: %s\n' "$USERNAME" "$WRAPPER_FILE" >"$candidate_tmp"

# Keep the candidate to a single literal policy line with a final newline.
if grep -qE '[\$`]' "$candidate_tmp"; then
    printf '%s\n' 'Error: generated sudoers content contains shell-expansion characters' >&2
    exit 1
fi
last_byte=$(tail -c 1 "$candidate_tmp" | od -An -t x1 | tr -d ' \n')
if [[ "$last_byte" != '0a' ]]; then
    printf '%s\n' 'Error: generated sudoers content has no trailing newline' >&2
    exit 1
fi

printf '%s\n' 'Validating candidate sudoers file...'
if ! sudo visudo -c -f "$candidate_tmp"; then
    printf '%s\n' 'Error: Invalid sudoers file; existing policy was left unchanged' >&2
    exit 1
fi

sudo install -m 0440 -o root -g root "$candidate_tmp" "$SUDOERS_FILE"
printf '%s\n' 'Sudoers file created successfully'
