#!/bin/bash
# install-hooks -- wire coding agents' lifecycle hooks to tmux-agent.
# Usage: tmux-agent install-hooks [claude] [codex] [opencode]  (default: all)
#
#   claude    ~/.claude/settings.json   "hooks" entries (merged)
#   codex     ~/.codex/hooks.json       "hooks" entries (merged)
#   opencode  ~/.config/opencode/plugins/tmux-agent (symlinked directory)
#
# Re-running replaces earlier tmux-agent entries and keeps everything else.
set -euo pipefail

LIB="$(dirname "$(readlink -f "$0")")"
declare -r LIB
# Absolute path: Codex does not run hook commands through a shell.
BIN="$HOME/.local/bin/tmux-agent"
[[ -x $BIN ]] || BIN="$(readlink -f "$LIB/../../bin/tmux-agent")"
declare -r BIN

# Events each agent reports, "Event" or "Event=matcher". Claude's
# Notification only means blocked for permission and question dialogs.
declare -r CLAUDE_EVENTS='SessionStart UserPromptSubmit PreToolUse PostToolUse PermissionRequest Notification=permission_prompt|elicitation_dialog Stop SessionEnd'
declare -r CODEX_EVENTS='SessionStart UserPromptSubmit PreToolUse PostToolUse PermissionRequest Stop SessionEnd'

merge_hooks() {
    # $1 JSON settings file, $2 agent name, $3 event list. Drops previous
    # tmux-agent hooks, then appends one per event.
    local file=$1 agent=$2 events=$3 tmp
    mkdir -p "$(dirname "$file")"
    [[ -s $file ]] || echo '{}' >"$file"
    tmp=$(mktemp "$file.XXXXXX")
    jq --arg bin "$BIN" --arg agent "$agent" --arg events "$events" '
        def ours: any(.hooks[]?; (.command // "") | test("tmux-agent\"? hook "));
        .hooks = ((.hooks // {})
            | with_entries(.value |= map(select(ours | not)))
            | with_entries(select(.value | length > 0)))
        | reduce ($events | split(" ")[]) as $spec (.;
            ($spec | split("=")) as [$event, $matcher]
            | .hooks[$event] += [
                ({hooks: [{type: "command", timeout: 5,
                           command: "\($bin) hook \($agent) \($event)"}]}
                 + (if $matcher then {matcher: $matcher} else {} end))
              ])
    ' "$file" >"$tmp"
    # Write through the path so a symlinked settings file stays a symlink.
    cat "$tmp" >"$file"
    rm -f "$tmp"
    echo "tmux-agent: $agent hooks -> $file"
}

install_claude() {
    merge_hooks "$HOME/.claude/settings.json" claude "$CLAUDE_EVENTS"
}

install_codex() {
    local config="$HOME/.codex/config.toml"
    merge_hooks "$HOME/.codex/hooks.json" codex "$CODEX_EVENTS"
    if ! awk '/^\[/{s=$0} s=="[features]" && /^[[:space:]]*hooks[[:space:]]*=[[:space:]]*true/{f=1} END{exit !f}' \
        "$config" 2>/dev/null; then
        echo "tmux-agent: add 'hooks = true' under [features] in $config to enable Codex hooks" >&2
    fi
}

install_opencode() {
    # OpenCode 2 loads directory plugins from plugins/: index.js for the
    # shared server, tui.js for the TUI that runs in the pane.
    local dir="$HOME/.config/opencode" tmp
    mkdir -p "$dir/plugins"
    ln -sfn "$LIB/opencode" "$dir/plugins/tmux-agent"
    # Drop the single-file links and tui.jsonc entry earlier versions made.
    rm -f "$dir/plugins/tmux-agent.js" "$dir/tmux-agent-tui.js"
    if [[ -f $dir/tui.jsonc ]] && jq -e '.plugin | index("./tmux-agent-tui.js")' "$dir/tui.jsonc" >/dev/null 2>&1; then
        tmp=$(mktemp "$dir/tui.jsonc.XXXXXX")
        jq '.plugin -= ["./tmux-agent-tui.js"]' "$dir/tui.jsonc" >"$tmp" && cat "$tmp" >"$dir/tui.jsonc"
        rm -f "$tmp"
    fi
    echo "tmux-agent: opencode plugin -> $dir/plugins/tmux-agent"
}

main() {
    command -v jq >/dev/null 2>&1 || {
        echo "tmux-agent: install-hooks needs jq" >&2
        exit 1
    }
    (($#)) || set -- claude codex opencode
    local agent
    for agent in "$@"; do
        case $agent in
        claude | codex | opencode) "install_$agent" ;;
        *)
            echo "tmux-agent: unknown agent '$agent' (claude, codex, opencode)" >&2
            exit 1
            ;;
        esac
    done
}

main "$@"
