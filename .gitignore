scripts/.local/share
scripts/.local/state
scripts/.local/lib

# Backup directories
scripts.backup.*

# Sensitive files
*.key
*.pem
*.gpg
id_rsa*
id_ed25519*
known_hosts
known_hosts.old
.env
.env.*
*.env

# ssh/.ssh and gnupg/.gnupg hold private keys whenever ~/.ssh or ~/.gnupg is a
# folded Stow link into them. Only our own files are tracked there, so nothing
# else that lands in them can be committed by accident.
ssh/.ssh/*
!ssh/.ssh/config
gnupg/.gnupg/*
!gnupg/.gnupg/gpg-agent.conf

# OS files
.DS_Store
Thumbs.db

# Editor files
*.swp
*.swo
*~
.vscode/
.idea/

# Python bytecode from the test suite
__pycache__/
*.pyc
.pytest_cache/

# Local-only configuration and credentials
.claude/settings.local.json
.claude/worktrees/
secrets.json
credentials.json
*.token

# Rendered by themes/themectl from templates/ and palettes/. These land inside
# stowed package directories, so git would otherwise track a compositor's or a
# terminal's generated colors. Run `themectl apply` after a fresh clone.
alacritty/.config/alacritty/theme.toml
awesome/.config/awesome/themes/powerarrow/colors.lua
btop/.config/btop/themes/themectl.theme
ghostty/.config/ghostty/theme
ghossty/.config/ghostty/theme
yazi/.config/yazi/theme.toml
hyprland/.config/hypr/lua/theme.lua
hyprland/.config/hypr/theme.conf
hyprland/.config/rofi/config.rasi
hyprland/.config/swaync/colors.css
hyprland/.config/waybar/colors.css
hyprland/.config/waybar/config.jsonc

# Written by plugins/pluginctl from enabled plugins' hypr.lua / awesome.lua
# fragments. hyprland.lua and theme.lua both require these unconditionally,
# so they must always exist; run `pluginctl refresh` after a fresh clone.
hyprland/.config/hypr/lua/plugins.lua
awesome/.config/awesome/plugins.lua
plugins/.pluginctl.lock
plugins/.transaction.*

# Written by display-detect from the connected outputs and wallpaper set.
hyprland/.config/hypr/lock-backgrounds.conf

# Generated theme output and synchronization state.
themes/out
themes/.generations/
themes/.apply.lock

# Stow links ~/.config/autostart to this folder when it did not exist, so apps
# that add their own autostart entries write them here; keep only ours.
picom/.config/autostart/*
!picom/.config/autostart/picom.desktop

# `ya pkg install` writes plugins and flavors next to package.toml; they would
# land here if ~/.config/yazi were ever a folded Stow link.
yazi/.config/yazi/plugins/
yazi/.config/yazi/flavors/
