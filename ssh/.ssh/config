# SSH Configuration
# Global options
Host *
    # Security
    PasswordAuthentication no
    ChallengeResponseAuthentication no
    PubkeyAuthentication yes
    # ssh-rsa uses SHA-1; keep modern RSA SHA-2 and Ed25519 host keys enabled.
    HostKeyAlgorithms ssh-ed25519-cert-v01@openssh.com,rsa-sha2-512-cert-v01@openssh.com,rsa-sha2-256-cert-v01@openssh.com,ssh-ed25519,rsa-sha2-512,rsa-sha2-256,ecdsa-sha2-nistp256,ecdsa-sha2-nistp521,ecdsa-sha2-nistp384

    # Connection settings
    ConnectTimeout 10
    ServerAliveInterval 60
    ServerAliveCountMax 3

    # Performance
    ControlMaster auto
    ControlPath ~/.ssh/cm-%C
    ControlPersist 10m

    # Identity
    IdentityFile ~/.ssh/id_ed25519
    IdentityFile ~/.ssh/id_rsa

# Example host configurations (customize as needed)
# Host my-server
#      HostName your-server-hostname
#      User your-username
#      Port 22
#      #     IdentityFile ~/.ssh/server_key
