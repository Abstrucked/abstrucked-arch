#!/bin/sh

set -eu

monitors=$(hyprctl monitors -j)
primary=$(printf '%s\n' "$monitors" | jq -r 'first(.[] | select(.width == 3440 and .height == 1440) | .name) // empty')
secondary=$(printf '%s\n' "$monitors" | jq -r 'first(.[] | select(.width == 1920 and .height == 1080) | .name) // empty')

if [ -n "$primary" ]; then
    hyprctl hyprpaper wallpaper "$primary,$HOME/.backgrounds/arch_wide_bluish.png" >/dev/null
fi

if [ -n "$secondary" ]; then
    hyprctl hyprpaper wallpaper "$secondary,$HOME/.backgrounds/cosmo.png" >/dev/null
fi
