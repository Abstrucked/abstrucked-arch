#!/bin/sh
# Apply the known monitor layout once the real connectors are reported: the
# 3440x1440 ultrawide first, the 1920x1080 panel to its right. With no
# ultrawide attached (laptop alone) the panel keeps its automatic placement.

set -eu

monitors=$(hyprctl monitors -j)
primary=$(printf '%s\n' "$monitors" | jq -r 'first(.[] | select(.width == 3440 and .height == 1440) | "\(.name)|\(.refreshRate)") // empty')
secondary=$(printf '%s\n' "$monitors" | jq -r 'first(.[] | select(.width == 1920 and .height == 1080) | "\(.name)|\(.refreshRate)") // empty')

[ -n "$primary" ] || exit 0

apply() {
    hyprctl eval "hl.monitor({ output = \"$1\", mode = \"$2\", position = \"$3\", scale = 1 })" >/dev/null
}

apply "${primary%%|*}" "3440x1440@${primary#*|}" "0x0"

if [ -n "$secondary" ]; then
    apply "${secondary%%|*}" "1920x1080@${secondary#*|}" "3440x0"
fi
