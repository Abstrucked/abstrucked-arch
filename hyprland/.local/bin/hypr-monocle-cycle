#!/bin/sh
# Alt+J / Alt+K: focus next/previous client by index. In the monocle layout
# the layout itself owns the ordering, so it gets the message instead.

set -eu

direction=${1:-next}
layout=$(hyprctl activeworkspace -j | jq -r '.tiledLayout // ""')

case "$direction" in
    next) message=cyclenext forward=true ;;
    previous) message=cycleprev forward=false ;;
    *)
        printf '%s\n' "Usage: hypr-monocle-cycle [next|previous]" >&2
        exit 2
        ;;
esac

if [ "$layout" = monocle ]; then
    hyprctl eval "hl.dispatch(hl.dsp.layout(\"$message\"))" >/dev/null
else
    hyprctl eval "hl.dispatch(hl.dsp.window.cycle_next({ next = $forward }))" >/dev/null
fi
