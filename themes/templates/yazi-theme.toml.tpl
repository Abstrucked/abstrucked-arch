# Generated by themectl from {{name}}. Do not edit; change the palette or
# templates/yazi-theme.toml.tpl in ~/.dotfiles/themes instead.
# Yazi merges this over its built-in theme-dark/theme-light preset, so only the
# colours are set here; icons and symbols stay with the preset. Blocks filled
# with a colour take the matching on_* text colour so they read on every palette.

[mgr]
cwd = { fg = "{{cyan}}" }

find_keyword  = { fg = "{{orange}}", bold = true, italic = true, underline = true }
find_position = { fg = "{{magenta}}", bold = true, italic = true }

symlink_target = { fg = "{{fg_dim}}", italic = true }

marker_copied   = { fg = "{{green}}", bg = "{{green}}" }
marker_cut      = { fg = "{{red}}", bg = "{{red}}" }
marker_marked   = { fg = "{{cyan}}", bg = "{{cyan}}" }
marker_selected = { fg = "{{yellow}}", bg = "{{yellow}}" }

count_copied   = { fg = "{{on_green}}", bg = "{{green}}" }
count_cut      = { fg = "{{on_red}}", bg = "{{red}}" }
count_selected = { fg = "{{on_yellow}}", bg = "{{yellow}}" }

border_style = { fg = "{{overlay}}" }

[tabs]
active   = { fg = "{{on_accent}}", bg = "{{accent}}", bold = true }
inactive = { fg = "{{fg}}", bg = "{{surface_alt}}" }

[mode]
normal_main = { fg = "{{on_accent}}", bg = "{{accent}}", bold = true }
normal_alt  = { fg = "{{accent}}", bg = "{{surface_alt}}" }

select_main = { fg = "{{on_yellow}}", bg = "{{yellow}}", bold = true }
select_alt  = { fg = "{{yellow}}", bg = "{{surface_alt}}" }

unset_main = { fg = "{{on_red}}", bg = "{{red}}", bold = true }
unset_alt  = { fg = "{{red}}", bg = "{{surface_alt}}" }

[indicator]
parent  = { fg = "{{fg}}", bg = "{{selection}}" }
current = { fg = "{{fg}}", bg = "{{selection}}", bold = true }
preview = { bg = "{{selection}}" }

[status]
overall = { fg = "{{fg}}", bg = "{{surface}}" }

perm_sep   = { fg = "{{fg_dim}}" }
perm_type  = { fg = "{{green}}" }
perm_read  = { fg = "{{orange}}" }
perm_write = { fg = "{{red}}" }
perm_exec  = { fg = "{{cyan}}" }

progress_label  = { fg = "{{fg}}", bold = true }
progress_normal = { fg = "{{green}}", bg = "{{surface_alt}}" }
progress_error  = { fg = "{{on_red}}", bg = "{{red}}" }

[which]
border          = { fg = "{{accent}}" }
mask            = { bg = "{{surface}}" }
cand            = { fg = "{{cyan}}" }
rest            = { fg = "{{fg_dim}}" }
desc            = { fg = "{{magenta}}" }
separator_style = { fg = "{{fg_dim}}" }

[confirm]
border  = { fg = "{{accent}}" }
title   = { fg = "{{accent}}" }
btn_yes = { fg = "{{on_accent}}", bg = "{{accent}}", bold = true }
btn_no  = { fg = "{{fg}}", bg = "{{surface_alt}}" }

[spot]
border   = { fg = "{{accent}}" }
title    = { fg = "{{accent}}" }
tbl_col  = { fg = "{{accent}}" }
tbl_cell = { fg = "{{on_accent}}", bg = "{{accent}}" }

[notify]
title_info  = { fg = "{{green}}" }
title_warn  = { fg = "{{orange}}" }
title_error = { fg = "{{red}}" }

[pick]
border = { fg = "{{accent}}" }
active = { fg = "{{magenta}}", bold = true }

[input]
border   = { fg = "{{accent}}" }
selected = { bg = "{{selection}}" }

[cmp]
border = { fg = "{{accent}}" }
active = { fg = "{{fg}}", bg = "{{selection}}", bold = true }

[tasks]
border  = { fg = "{{accent}}" }
hovered = { fg = "{{magenta}}", bg = "{{selection}}", bold = true }

[help]
border  = { fg = "{{accent}}" }
chord   = { fg = "{{cyan}}" }
hovered = { fg = "{{fg}}", bg = "{{selection}}", bold = true }

# Replaces the preset list, so it repeats the preset's rule order and matchers.
[filetype]
rules = [
	# Image
	{ mime = "**/image/*", fg = "{{orange}}" },
	# Media
	{ mime = "**/{audio,video}/*", fg = "{{magenta}}" },
	# Archive
	{ mime = "**/application/{zip,rar,7z*,tar,gzip,xz,zstd,bzip*,lzma,compress,archive,cpio,arj,xar,ms-cab*}", fg = "{{red}}" },
	# Document
	{ mime = "**/application/{pdf,doc,rtf}", fg = "{{cyan}}" },
	# Virtual file system
	{ mime = "vfs/{absent,stale}", fg = "{{fg_dim}}" },
	# Broken symlink
	{ url = "*", is = "orphan", fg = "{{red}}", italic = true, underline = true },
	# Executable
	{ url = "*", is = "exec", fg = "{{green}}" },
	# Dummy file
	{ url = "*", is = "dummy", fg = "{{red}}" },
	{ url = "*/", is = "dummy", fg = "{{red}}" },
	# Directory
	{ url = "*/", fg = "{{blue}}" }
]
