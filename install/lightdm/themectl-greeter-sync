#!/bin/bash
# themectl-greeter-sync - LightDM's greeter-setup-script. Runs as root just
# before the login screen starts and copies the active theme into places the
# greeter (running as the lightdm user) can read:
#
#   <stage>/gtk.css          -> /usr/share/themes/themectl-greeter/gtk-3.0/gtk.css
#   <stage>/{ultrawide,wide,internal} -> /usr/share/backgrounds/themectl/
#   <stage>/bg + xrandr      -> $GREETER_CONF (background per monitor)
#
# <stage> is written by themectl (themes/hooks/lightdm.sh) and is owned by the
# user, so everything in it is untrusted: files are read as that user (never
# with root's access), capped in size, and checked before use. The greeter
# config is written from scratch here, never copied, because it can name
# commands to run (keyboard=, reader=).
#
# A failing greeter-setup-script stops the login screen, so this always exits 0
# and leaves the previous theme in place on any error.
#
# Installed by install/lightdm-greeter.sh; configured by $CONF.

# THEMECTL_GREETER_ROOT relocates every path, for the tests only.
declare -r ROOT="${THEMECTL_GREETER_ROOT:-}"
declare -r CONF="$ROOT/etc/lightdm/themectl-greeter.conf"
declare -r THEME_OUT="$ROOT/usr/share/themes/themectl-greeter/gtk-3.0"
declare -r BG_OUT="$ROOT/usr/share/backgrounds/themectl"
declare -r GREETER_CONF="$ROOT/etc/xdg/lightdm/lightdm-gtk-greeter.conf.d/60-themectl.conf"
declare -r MAX_CSS=$((256 * 1024))
declare -r MAX_IMAGE=$((64 * 1024 * 1024))

log() {
  logger -t themectl-greeter-sync -- "$*" 2>/dev/null || echo "themectl-greeter-sync: $*" >&2
}

# Copy <stage>/<name> to <dest> reading it as the stage owner, at most <max>
# bytes. Fails (leaving nothing behind) if it is missing or too big.
fetch() {
  local name="$1" dest="$2" max="$3" as=()
  [[ "$EUID" == "$uid" ]] || as=(setpriv --reuid="$uid" --regid="$gid" --init-groups --)
  "${as[@]}" head -c "$((max + 1))" -- "$stage/$name" >"$dest" 2>/dev/null || return 1
  (($(stat -c %s -- "$dest") <= max)) || { log "$name is over $max bytes; skipped"; return 1; }
}

# Replace <dest> with <src> atomically, world-readable.
publish() {
  local src="$1" dest="$2" tmp
  mkdir -p -- "$(dirname -- "$dest")"
  tmp="$(mktemp -- "$dest.XXXXXX")"
  cat -- "$src" >"$tmp"
  chmod 644 -- "$tmp"
  mv -f -- "$tmp" "$dest"
}

read_conf() {
  local key value
  user="" stage=""
  [[ -r "$CONF" ]] || { log "$CONF missing"; return 1; }
  while IFS='=' read -r key value; do
    case "$key" in
      user) user="$value" ;;
      stage) stage="$value" ;;
    esac
  done <"$CONF"
  [[ "$user" =~ ^[a-z_][a-z0-9_-]*$ ]] || { log "bad user in $CONF"; return 1; }
  uid="$(id -u -- "$user")" && gid="$(id -g -- "$user")" || return 1
  [[ "$stage" == /* ]] || { log "stage in $CONF must be absolute"; return 1; }
}

sync_css() {
  local tmp="$work/gtk.css" rest
  fetch gtk.css "$tmp" "$MAX_CSS" || { log "no gtk.css staged; keeping the current theme"; return 0; }
  # GTK's own Adwaita is the only outside stylesheet or file the theme may
  # load; anything else could make the greeter read arbitrary files.
  rest="$(grep -Ev '^@import url\("resource:///org/gtk/libgtk/theme/Adwaita/gtk-contained(-dark)?\.css"\);$' "$tmp" || true)"
  if grep -qiE 'url\(|@import|-gtk-scaled|image\(' <<<"$rest"; then
    log "gtk.css loads external resources; keeping the current theme"
    return 0
  fi
  publish "$tmp" "$THEME_OUT/gtk.css"
  printf '[Desktop Entry]\nType=X-GNOME-Metatheme\nName=themectl-greeter\n' >"$work/index.theme"
  publish "$work/index.theme" "$(dirname -- "$THEME_OUT")/index.theme"
}

# Copy each staged wallpaper that really is a PNG or JPEG.
sync_wallpapers() {
  local class tmp magic ext other
  for class in ultrawide wide internal; do
    tmp="$work/$class"
    if ! fetch "$class" "$tmp" "$MAX_IMAGE"; then
      rm -f -- "$BG_OUT/$class".png "$BG_OUT/$class".jpg
      continue
    fi
    magic="$(od -An -tx1 -N8 -- "$tmp" | tr -d ' \n')"
    case "$magic" in
      89504e470d0a1a0a) ext=png other=jpg ;;
      ffd8ff*) ext=jpg other=png ;;
      *) log "$class wallpaper is not a PNG or JPEG; skipped"; continue ;;
    esac
    publish "$tmp" "$BG_OUT/$class.$ext"
    rm -f -- "$BG_OUT/$class.$other"
  done
}

# The background for a class, falling back like display-detect does.
background_for() {
  local c ext
  for c in "$1" wide; do
    for ext in png jpg; do
      [[ -e "$BG_OUT/$c.$ext" ]] && { echo "$BG_OUT/$c.$ext"; return; }
    done
  done
  echo "$bg"
}

write_greeter_conf() {
  local tmp="$work/greeter.conf" name w h class default
  bg=""
  if fetch bg "$work/bg" 64; then
    bg="$(head -n1 -- "$work/bg")"
  fi
  [[ "$bg" =~ ^#[0-9a-fA-F]{6}$ ]] || bg=""
  default="$(background_for wide)"
  {
    echo "# Generated by themectl-greeter-sync when the greeter starts. Do not edit."
    echo "[greeter]"
    [[ -z "$default" ]] || echo "background=$default"
    # Per-monitor wallpapers, classified like display-detect. xrandr needs the
    # greeter's display, which LightDM passes to this script.
    if [[ -n "${DISPLAY:-}" ]] && command -v xrandr >/dev/null; then
      while read -r name w h; do
        if [[ "$name" =~ ^(eDP|LVDS|DSI) ]]; then
          class=internal
        elif ((w >= 2 * h)); then
          class=ultrawide
        else
          class=wide
        fi
        echo
        echo "[monitor: $name]"
        echo "background=$(background_for "$class")"
        [[ "$class" != internal ]] || echo "laptop=true"
      done < <(timeout 5 xrandr --current 2>/dev/null |
        sed -nE 's/^([A-Za-z0-9-]+) connected (primary )?([0-9]+)x([0-9]+)\+.*/\1 \3 \4/p')
    fi
  } >"$tmp"
  publish "$tmp" "$GREETER_CONF"
}

main() {
  set -euo pipefail
  read_conf
  [[ -d "$stage" ]] || { log "$stage missing; run themectl apply as $user"; return 0; }
  work="$(mktemp -d)"
  trap 'rm -rf -- "$work"' EXIT
  sync_css
  sync_wallpapers
  write_greeter_conf
}

# Not `(main) || ...`: that context would silently disable set -e inside main.
(main)
(($? == 0)) || log "sync failed; the greeter keeps the previous theme"
exit 0
